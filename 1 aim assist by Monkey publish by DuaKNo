	left.Size = UDim2.new(0.58, -10, 1, 0)
	left.BackgroundTransparency = 1
	left.Text = name
	left.TextXAlignment = Enum.TextXAlignment.Left
	left.TextColor3 = TEXT
	left.Font = FONT
	left.TextSize = 14
	left.Parent = row

	local right = Instance.new("TextLabel")
	right.AnchorPoint = Vector2.new(1, 0)
	right.Position = UDim2.new(1, -10, 0, 0)
	right.Size = UDim2.new(0.42, 0, 1, 0)
	right.BackgroundTransparency = 1
	right.TextXAlignment = Enum.TextXAlignment.Right
	right.Font = FONT
	right.TextSize = 14
	right.Parent = row

	local function refresh()
		local ok, t = pcall(getText)
		local ok2, c = pcall(getColor)
		right.Text = ok and tostring(t) or "[error]"
		right.TextColor3 = (ok2 and c) or RED
		if not (ok and ok2) then FX.logError("menu row: " .. name, ok and c or t) end
	end
	row.MouseButton1Click:Connect(function()
		local ok, err = pcall(onClick)
		if not ok then FX.logError("click: " .. name, err) end
		refresh()
	end)
	row.MouseButton2Click:Connect(function() if FX.toggleFav then FX.toggleFav(name) end end)
	refresh()
	FX.ui[#FX.ui + 1] = refresh
	FX.favMark[#FX.favMark + 1] = { name = name, stroke = rowStroke }
	return refresh
end

