local listFrame = Instance.new("ScrollingFrame")
listFrame.LayoutOrder = nextOrder()
listFrame.Size = UDim2.new(1, 0, 0, 150)
listFrame.BackgroundColor3 = BG
listFrame.BorderSizePixel = 0
listFrame.ScrollBarThickness = 3
listFrame.ScrollBarImageColor3 = BORDER
listFrame.CanvasSize = UDim2.new()
listFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
listFrame.Parent = content
addStroke(listFrame)
local listLayout = Instance.new("UIListLayout")
listLayout.Padding = UDim.new(0, 2)
listLayout.SortOrder = Enum.SortOrder.LayoutOrder
listLayout.Parent = listFrame

rebuildList = function()
	for _, c in ipairs(listFrame:GetChildren()) do
		if c:IsA("TextButton") then c:Destroy() end
	end
	local entries = { { label = "everyone", name = nil } }
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			table.insert(entries, { label = p.DisplayName .. " (@" .. p.Name .. ")", name = p.Name })
		end
	end
	if CONFIG.TargetNPCs then
		for humanoid in pairs(humanoids) do
			local model = humanoid.Parent
			if model and model:IsA("Model") and humanoid.Health > 0 and #entries < 41
				and not Players:GetPlayerFromCharacter(model) and isCharacter(model) and not isSelf(model) then
				table.insert(entries, { label = "[npc] " .. model.Name, name = npcIdFor(model) })
			end
		end
	end
	for i, e in ipairs(entries) do
		local b = Instance.new("TextButton")
		b.LayoutOrder = i
		b.Size = UDim2.new(1, -6, 0, 26)
		b.BackgroundColor3 = ROWBG
		b.BorderSizePixel = 0
		b.Text = "  " .. e.label
		b.TextXAlignment = Enum.TextXAlignment.Left
		b.TextTruncate = Enum.TextTruncate.AtEnd
		local qi = e.name and table.find(CONFIG.TargetNames, e.name)
		local picked = (e.name == nil and #CONFIG.TargetNames == 0) or qi ~= nil
		b.TextColor3 = picked and GREEN or TEXT
		if qi then b.Text = "  " .. qi .. ". " .. e.label end
		b.Font = FONT
		b.TextSize = 13
		b.AutoButtonColor = false
		b.Parent = listFrame
		hoverable(b)
		b.MouseButton1Click:Connect(function()
			if not e.name then
				table.clear(CONFIG.TargetNames)
			else
				local idx = table.find(CONFIG.TargetNames, e.name)
				if idx then
					table.remove(CONFIG.TargetNames, idx)
				else
					table.insert(CONFIG.TargetNames, e.name)
				end
			end
			updateQueue()
			sticky = nil
			lockedModel = nil
			queueChain = false
			rebuildList()
		end)
	end
end

onQueueChanged = rebuildList
Players.PlayerAdded:Connect(function() rebuildList() end)
Players.PlayerRemoving:Connect(function(p)
	local idx = table.find(CONFIG.TargetNames, p.Name)
	if idx then table.remove(CONFIG.TargetNames, idx) end
	task.defer(rebuildList)
end)
rebuildList()

do -- rebuild the list when someone joins / leaves / an npc appears
	local lastSig = ""
	task.spawn(function()
		while true do
			task.wait(1)
			local sig = {}
			for _, pl in ipairs(Players:GetPlayers()) do sig[#sig + 1] = pl.Name end
			if CONFIG.TargetNPCs then
				for h in pairs(humanoids) do
					local m = h.Parent
					if m and m:IsA("Model") and h.Health > 0 and not Players:GetPlayerFromCharacter(m) and isCharacter(m) and not isSelf(m) then
						sig[#sig + 1] = npcIdFor(m)
					end
				end
			end
			table.sort(sig)
			local joined = table.concat(sig, ",")
			if joined ~= lastSig then
				lastSig = joined
				rebuildList()
			end
		end
	end)
end

