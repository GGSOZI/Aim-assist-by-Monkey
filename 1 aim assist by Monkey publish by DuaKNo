-- themes: recolour every menu element by swapping the old palette for the new one
do
	local palettes = {
		dark = { Color3.fromRGB(20, 20, 20), Color3.fromRGB(32, 32, 32), Color3.fromRGB(46, 46, 46), Color3.fromRGB(62, 62, 62), Color3.fromRGB(215, 215, 215), Color3.fromRGB(140, 140, 140), Color3.fromRGB(110, 205, 120), Color3.fromRGB(205, 95, 85) },
		ocean = { Color3.fromRGB(12, 20, 32), Color3.fromRGB(20, 34, 52), Color3.fromRGB(30, 50, 76), Color3.fromRGB(50, 80, 115), Color3.fromRGB(210, 225, 240), Color3.fromRGB(120, 145, 170), Color3.fromRGB(90, 200, 220), Color3.fromRGB(235, 110, 110) },
		violet = { Color3.fromRGB(22, 16, 32), Color3.fromRGB(34, 26, 50), Color3.fromRGB(50, 38, 72), Color3.fromRGB(80, 62, 115), Color3.fromRGB(225, 215, 240), Color3.fromRGB(150, 135, 175), Color3.fromRGB(190, 130, 255), Color3.fromRGB(240, 110, 140) },
		light = { Color3.fromRGB(235, 235, 238), Color3.fromRGB(250, 250, 252), Color3.fromRGB(220, 222, 228), Color3.fromRGB(170, 172, 180), Color3.fromRGB(30, 30, 35), Color3.fromRGB(110, 110, 120), Color3.fromRGB(40, 150, 70), Color3.fromRGB(200, 60, 55) },
	}
	FX.applyTheme = function(name)
		local new = palettes[name] or palettes.dark
		local old = { BG, ROWBG, ROW_HOVER, BORDER, TEXT, DIM, GREEN, RED }
		local function swap(c)
			for i = 1, 8 do
				if c == old[i] then return new[i] end
			end
			return c
		end
		local function recolor(root)
			for _, d in ipairs(root:GetDescendants()) do
				if d:IsA("GuiObject") then d.BackgroundColor3 = swap(d.BackgroundColor3) end
				if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then d.TextColor3 = swap(d.TextColor3) end
				if d:IsA("TextBox") then d.PlaceholderColor3 = swap(d.PlaceholderColor3) end
				if d:IsA("UIStroke") then d.Color = swap(d.Color) end
				if d:IsA("ScrollingFrame") then d.ScrollBarImageColor3 = swap(d.ScrollBarImageColor3) end
			end
			if root:IsA("GuiObject") then root.BackgroundColor3 = swap(root.BackgroundColor3) end
		end
		recolor(window)
		toast.BackgroundColor3 = new[1]
		BG, ROWBG, ROW_HOVER, BORDER, TEXT, DIM, GREEN, RED = new[1], new[2], new[3], new[4], new[5], new[6], new[7], new[8]
		ACCENT = GREEN
		FX.refreshUI()
	end
	if CONFIG.Theme ~= "dark" then FX.applyTheme(CONFIG.Theme) end
end

-- tabs + search + favourites: one view function decides which rows are shown
do
	local GOLD = Color3.fromRGB(240, 200, 70)
	local function rowText(obj)
		local l = obj:FindFirstChildWhichIsA("TextLabel", true)
		return l and l.Text:lower() or ""
	end
	function FX.favSet()
		local set = {}
		for item in string.gmatch(CONFIG.Favs, "[^|]+") do set[item:lower()] = true end
		return set
	end
	local function applyView()
		local q = searchBox.Text:lower()
		local tab = FX.tab
		local favs = FX.favSet()
		for _, g in ipairs(groupsList) do
			if q == "" and tab ~= "favs" then
				for _, c in ipairs(g.body:GetChildren()) do
					if c:IsA("GuiObject") then c.Visible = true end
				end
				if g.saved ~= nil then g.setOpen(g.saved) g.saved = nil end
				g.holder.Visible = tab == "all" or g.tab == tab
				if tab ~= "all" and g.tab == tab and not g.isOpen() then g.setOpen(true) end
			else
				if g.saved == nil then g.saved = g.isOpen() end
				local any = false
				for _, c in ipairs(g.body:GetChildren()) do
					if c:IsA("GuiObject") then
						local isRow = c:IsA("TextButton") or c:IsA("Frame")
						local t = isRow and rowText(c) or ""
						local match = isRow and t ~= ""
						if match and q ~= "" then match = string.find(t, q, 1, true) ~= nil end
						if match and tab == "favs" then match = favs[t] == true end
						c.Visible = match
						if match then any = true end
					end
				end
				g.holder.Visible = any
				g.setOpen(any)
			end
		end
	end
	FX.applyView = applyView
	function FX.applyFavMarks()
		local favs = FX.favSet()
		for _, m in ipairs(FX.favMark) do
			m.stroke.Color = favs[m.name:lower()] and GOLD or BORDER
		end
	end
	function FX.toggleFav(name)
		local key, names, found = name:lower(), {}, false
		for item in string.gmatch(CONFIG.Favs, "[^|]+") do
			if item:lower() == key then found = true else names[#names + 1] = item end
		end
		if not found then
			names[#names + 1] = name
			if #table.concat(names, "|") > 580 then FX.notify("favourites list is full", false) return end
		end
		CONFIG.Favs = table.concat(names, "|")
		FX.applyFavMarks()
		if FX.tab == "favs" then applyView() end
		FX.notify(name .. (found and ": removed from favs" or ": added to favs"), not found)
	end

	-- tab bar
	local tabs = { { "all", "all" }, { "aim", "aim" }, { "visuals", "visuals" }, { "move", "move" }, { "fun", "fun" },
		{ "admin", "admin" }, { "tools", "tools" }, { "menu", "menu" }, { "favs", "favs" } }
	local bar = Instance.new("Frame")
	bar.LayoutOrder = -1
	bar.Size = UDim2.new(1, 0, 0, 0)
	bar.AutomaticSize = Enum.AutomaticSize.Y
	bar.BackgroundTransparency = 1
	bar.Parent = page
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.new(1 / 3, -4, 0, 24)
	grid.CellPadding = UDim2.fromOffset(4, 4)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = bar
	local buttons = {}
	local function paintTabs()
		for name, b in pairs(buttons) do
			b.TextColor3 = (name == FX.tab) and GREEN or TEXT
		end
	end
	for i, t in ipairs(tabs) do
		local b = Instance.new("TextButton")
		b.LayoutOrder = i
		b.BackgroundColor3 = ROWBG
		b.BorderSizePixel = 0
		b.Text = t[2]
		b.TextColor3 = TEXT
		b.Font = FONT
		b.TextSize = 13
		b.AutoButtonColor = false
		b.Parent = bar
		addStroke(b)
		hoverable(b)
		buttons[t[1]] = b
		b.MouseButton1Click:Connect(function()
			FX.tab = t[1]
			paintTabs()
			applyView()
		end)
	end
	paintTabs()
	FX.ui[#FX.ui + 1] = paintTabs
	searchBox:GetPropertyChangedSignal("Text"):Connect(applyView)

	-- theme changes recolour the favourite outlines too
	local oldTheme = FX.applyTheme
	FX.applyTheme = function(name)
		oldTheme(name)
		FX.applyFavMarks()
	end
	FX.applyFavMarks()

	-- after importing a settings code every live system gets the new values
	FX.afterImport = function()
		applyMenu()
		FX.applyTheme(CONFIG.Theme)
		FX.setAesthetic(CONFIG.Aesthetic)
		FX.setCamFx(CONFIG.CamFx)
		refreshCircle()
		FX.refreshUI()
		FX.applyFavMarks()
	end
end

