FX.hist = {}
FX.paused = false
FX.camfxList = { "off", "vhs", "retro", "glitch", "cold", "heat" }
FX.teamSkip = {}
FX.friends = {}

do
	local Lighting2 = game:GetService("Lighting")
	local function myRoot2() return player.Character and player.Character:FindFirstChild("HumanoidRootPart") end
	local function myHum2() return player.Character and player.Character:FindFirstChildOfClass("Humanoid") end

	-- ---------- whitelist / friends / ignored teams ----------
	local function parseList(str, into)
		table.clear(into)
		for item in string.gmatch(str or "", "[^,]+") do
			item = item:match("^%s*(.-)%s*$")
			if item ~= "" then into[item:lower()] = true end
		end
	end
	function FX.wlSync()
		parseList(CONFIG.Whitelist, FX.wl)
		parseList(CONFIG.IgnoreTeams, FX.teamSkip)
	end
	FX.wlSync()
	-- adds or removes one name in a comma list stored in CONFIG[cfgKey]; returns true when it was added, false when removed
	function FX.listToggle(cfgKey, name)
		local key, names, found = name:lower(), {}, false
		for item in string.gmatch(CONFIG[cfgKey], "[^,]+") do
			item = item:match("^%s*(.-)%s*$")
			if item:lower() == key then found = true elseif item ~= "" then names[#names + 1] = item end
		end
		if not found then
			names[#names + 1] = name
			if #table.concat(names, ",") > 270 then FX.notify("list is full", false) return nil end
		end
		CONFIG[cfgKey] = table.concat(names, ",")
		FX.wlSync()
		return not found
	end
	function FX.skip(owner)
		if FX.wl[owner.Name:lower()] then return true end
		if CONFIG.FriendsSkip and FX.friends[owner.UserId] then return true end
		local tm = owner.Team
		if tm and FX.teamSkip[tm.Name:lower()] then return true end
		return false
	end
	local function checkFriend(plr)
		if plr == player or FX.friends[plr.UserId] ~= nil then return end
		FX.friends[plr.UserId] = false
		task.spawn(function()
			local ok, res = pcall(function() return player:IsFriendsWith(plr.UserId) end)
			if ok and res then FX.friends[plr.UserId] = true end
		end)
	end
	for _, p in ipairs(Players:GetPlayers()) do checkFriend(p) end
	Players.PlayerAdded:Connect(checkFriend)

	-- ---------- target history + previous target ----------
	function FX.pushHist(m)
		local h = FX.hist
		if h[#h] ~= m then h[#h + 1] = m end
		if #h > 10 then table.remove(h, 1) end
	end
	function FX.prevTarget()
		local h = FX.hist
		while #h > 0 do
