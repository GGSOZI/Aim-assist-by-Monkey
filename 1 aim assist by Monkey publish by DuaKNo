	FX.tpRandom = function()
		local list = {}
		for _, pl in ipairs(Players:GetPlayers()) do
			local r = pl ~= player and pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
			if r then list[#list + 1] = r end
		end
		local root = myRoot()
		if root and #list > 0 then root.CFrame = list[math.random(#list)].CFrame * CFrame.new(0, 0, 4) end
	end

	-- ctrl + click = teleport to where you click, B = blink forward
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if FX.rebinding then return end
		if input.KeyCode == FX.kc("BindBlink") then blink() return end
		-- alt + click on a player / npc = make them the victim
		if input.UserInputType == Enum.UserInputType.MouseButton1 and UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) and camera then
			local pos = UserInputService:GetMouseLocation()
			local ray = camera:ViewportPointToRay(pos.X, pos.Y)
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { player.Character }
			local hit = Workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
			local m = hit and hit.Instance:FindFirstAncestorOfClass("Model")
			while m and not m:FindFirstChildOfClass("Humanoid") do m = m:FindFirstAncestorOfClass("Model") end
			if m and isCharacter(m) and not isSelf(m) then
				local pl = Players:GetPlayerFromCharacter(m)
				victimRef.name = pl and pl.Name or npcIdFor(m)
				if FX.onVictimChanged then FX.onVictimChanged() end
				FX.notify("victim: " .. m.Name, true)
			end
			return
		end
		if not T.click then return end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 or not UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then return end
		local root = myRoot()
		if not root or not camera then return end
		local pos = UserInputService:GetMouseLocation()
		local ray = camera:ViewportPointToRay(pos.X, pos.Y)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { player.Character }
		local hit = Workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
		if hit then root.CFrame = CFrame.new(hit.Position + Vector3.new(0, 4, 0)) end
	end)

