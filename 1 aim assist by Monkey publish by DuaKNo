-- ===== SAFETY NET: every loop / event of this script runs inside pcall, an error is logged (menu > diagnostics) and never stops the rest =====
local FX = { ui = {}, jumpOn = false, camFovOn = false, fullbrightOn = false, version = "2.0", errs = {}, errCount = 0, wl = {}, onError = nil, safeMode = false }
do
	-- only one copy of the hub may run: a second copy (an old script that is still in the game, or the file pasted twice)
	-- closes the old window and stops the old loops, so buttons never show up twice
	local token = {}
	shared.MonkeyHubToken = token
	function FX.stale() return shared.MonkeyHubToken ~= token end
	local pg = player:FindFirstChild("PlayerGui")
	if pg then
		for _, g in ipairs(pg:GetChildren()) do
			if g.Name == "AimAssistGui" then
				g:Destroy()
				FX.dupe = true
			end
		end
	end
	local realRS, realTask = game:GetService("RunService"), task
	local function lineOf(fn)
		local ok, l = pcall(debug.info, fn, "l")
		return ok and l or 0
	end
	function FX.logError(name, msg)
		FX.errCount += 1
		msg = tostring(msg)
		local list = FX.errs
		local last = list[#list]
		if last and last.name == name and last.msg == msg then
			last.n += 1
			last.t = os.clock()
		else
			list[#list + 1] = { name = name, msg = msg, n = 1, t = os.clock() }
			if #list > 30 then table.remove(list, 1) end
		end
		warn("[monkey hub] " .. name .. ": " .. msg)
		if FX.onError then pcall(FX.onError) end
	end
	-- loops: after 15 errors in a row the loop sleeps 5 seconds (so a broken loop cannot flood or lag the game), then tries again
	function FX.safe(name, fn)
		local st = { n = 0, mute = 0 }
		return function(...)
			if FX.stale() then return end
			if st.mute > 0 and os.clock() < st.mute then return end
			local ok, err = pcall(fn, ...)
			if not ok then
				st.n += 1
				FX.logError(name, err)
				if st.n >= 15 then
					st.mute = os.clock() + 5
					st.n = 0
				end
			elseif st.n > 0 then
				st.n = 0
			end
		end
	end
	local function safeOnce(name, fn)
		return function(...)
			local ok, err = pcall(fn, ...)
			if not ok then FX.logError(name, err) end
		end
	end
	local function proxySignal(sigName)
		local sig = realRS[sigName]
		return {
			Connect = function(_, fn) return sig:Connect(FX.safe(sigName .. "@L" .. lineOf(fn), fn)) end,
			Wait = function() return sig:Wait() end,
		}
	end
	FX.rs = setmetatable({
		Heartbeat = proxySignal("Heartbeat"),
		RenderStepped = proxySignal("RenderStepped"),
		Stepped = proxySignal("Stepped"),
		BindToRenderStep = function(_, n, p, fn) return realRS:BindToRenderStep(n, p, FX.safe(n, fn)) end,
	}, { __index = function(_, k)
		local v = realRS[k]
		if type(v) == "function" then return function(_, ...) return v(realRS, ...) end end
		return v
	end })
	FX.task = setmetatable({
		spawn = function(fn, ...)
			if type(fn) == "function" then return realTask.spawn(safeOnce("task@L" .. lineOf(fn), fn), ...) end
			return realTask.spawn(fn, ...)
		end,
		defer = function(fn, ...)
			if type(fn) == "function" then return realTask.defer(safeOnce("task@L" .. lineOf(fn), fn), ...) end
			return realTask.defer(fn, ...)
		end,
		delay = function(t, fn, ...)
			if type(fn) == "function" then return realTask.delay(t, safeOnce("delay@L" .. lineOf(fn), fn), ...) end
			return realTask.delay(t, fn, ...)
		end,
	}, { __index = realTask })
end
local RunService = FX.rs
local task = FX.task

-- ===== START MESSAGE (roblox's own notification, shown once when the script starts) =====
do
	local StarterGui = game:GetService("StarterGui")
	local function showStartMessage()
		StarterGui:SetCore("SendNotification", {
			Title = "Aim assist",
			Text = "By Monkey\nPublished by DuaKNo",
			Duration = 6,
		})
	end
	task.spawn(function()
		-- SetCore is not ready in the first moments of a session, so it retries quietly for a few seconds
		for _ = 1, 20 do
			if pcall(showStartMessage) then return end
			task.wait(0.5)
		end
	end)
end

