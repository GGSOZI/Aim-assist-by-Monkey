-- ===== FPS BOOSTER (client side graphics cuts, everything is restored when you turn it off) =====
do
	local Lighting = game:GetService("Lighting")
	local P = { boost = false, potato = false }
	FX.perf = P
	local saved = { effects = {}, emitters = {}, mats = {}, decals = {} }
	local function isEmitter(d)
		return d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles")
	end
	local function onCharacter(d)
		local m = d:FindFirstAncestorOfClass("Model")
		return m ~= nil and m:FindFirstChildOfClass("Humanoid") ~= nil
	end

	local function boostOn()
		saved.shadows = Lighting.GlobalShadows
		Lighting.GlobalShadows = false
		pcall(function() saved.quality = settings().Rendering.QualityLevel settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
		local cam = Workspace.CurrentCamera
		for _, root in ipairs({ Lighting, cam }) do
			if root then
				for _, d in ipairs(root:GetDescendants()) do
					if d:IsA("PostEffect") and d.Enabled then saved.effects[d] = true d.Enabled = false end
				end
			end
		end
		for _, d in ipairs(Workspace:GetDescendants()) do
			if isEmitter(d) and d.Enabled then saved.emitters[d] = true d.Enabled = false end
		end
		pcall(function()
			local t = Workspace.Terrain
			saved.deco, saved.wave = t.Decoration, t.WaterWaveSize
			t.Decoration = false
			t.WaterWaveSize = 0
		end)
	end
	local function boostOff()
		if saved.shadows ~= nil then Lighting.GlobalShadows = saved.shadows saved.shadows = nil end
		if saved.quality then pcall(function() settings().Rendering.QualityLevel = saved.quality end) saved.quality = nil end
		for d in pairs(saved.effects) do if d.Parent then d.Enabled = true end end
		for d in pairs(saved.emitters) do if d.Parent then d.Enabled = true end end
		table.clear(saved.effects)
		table.clear(saved.emitters)
		pcall(function()
			local t = Workspace.Terrain
			if saved.deco ~= nil then t.Decoration = saved.deco end
			if saved.wave ~= nil then t.WaterWaveSize = saved.wave end
		end)
	end
	Workspace.DescendantAdded:Connect(function(d)
		if P.boost and isEmitter(d) and d.Enabled then saved.emitters[d] = true d.Enabled = false end
	end)

	local potatoRun = 0
	local function potatoOn()
		potatoRun += 1
		local run = potatoRun
		task.spawn(function()
			local n = 0
			for _, d in ipairs(Workspace:GetDescendants()) do
				if run ~= potatoRun or not P.potato then return end
				if d:IsA("BasePart") and not d:IsA("Terrain") and not onCharacter(d) then
					saved.mats[d] = { d.Material, d.CastShadow }
					d.Material = Enum.Material.SmoothPlastic
					d.CastShadow = false
				elseif (d:IsA("Decal") or d:IsA("Texture")) and d.Transparency < 1 then
					saved.decals[d] = d.Transparency
					d.Transparency = 1
				end
				n += 1
				if n % 400 == 0 then task.wait() end -- do not freeze the game while converting
			end
		end)
	end
	local function potatoOff()
		potatoRun += 1
		for d, v in pairs(saved.mats) do
			if d.Parent then d.Material = v[1] d.CastShadow = v[2] end
		end
		for d, t in pairs(saved.decals) do
			if d.Parent then d.Transparency = t end
		end
		table.clear(saved.mats)
		table.clear(saved.decals)
	end

	FX.setPerf = function(k, v)
		if P[k] == v then return end
		P[k] = v
		if k == "boost" then
			if v then boostOn() else boostOff() end
		else
			if v then potatoOn() else potatoOff() end
		end
	end

	-- live fps (smoothed)
	FX.fps = 60
	RunService.RenderStepped:Connect(function(dt)
		FX.fps = FX.fps + (1 / math.max(dt, 1e-4) - FX.fps) * 0.05
	end)
end

