	end
	local function makeTrail(root)
		local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
		a0.Position, a1.Position = Vector3.new(0, 1, 0), Vector3.new(0, -1, 0)
		a0.Parent, a1.Parent = root, root
		local tr = Instance.new("Trail")
		tr.Attachment0, tr.Attachment1 = a0, a1
		tr.Lifetime = 0.8
		tr.LightEmission = 1
		tr.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)),
			ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 220, 60)),
			ColorSequenceKeypoint.new(0.66, Color3.fromRGB(60, 220, 120)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(80, 120, 255)),
		})
		tr.Parent = root
		trailObj = tr
	end
	local function removeTrail()
		if trailObj then
			if trailObj.Attachment0 then trailObj.Attachment0:Destroy() end
			if trailObj.Attachment1 then trailObj.Attachment1:Destroy() end
			trailObj:Destroy()
			trailObj = nil
		end
	end

	FX.setTroll = function(k, v)
		if FX.safeMode and v then return end
		if k == "invisible" then
			T.invisible = v
			local skin = game:GetService("ReplicatedStorage"):FindFirstChild("MonkeySkin")
			if skin then
				skin:FireServer(v and "hide" or "show")
			elseif v then
				FX.notify("server script missing: you only look see-through to yourself (see the bottom of the file)", false)
			end
			if not v and player.Character then
				for _, d in ipairs(player.Character:GetDescendants()) do
					if d:IsA("BasePart") then d.LocalTransparencyModifier = 0 end
				end
			end
			return
		end
		if k == "ghost" then -- preset: fly + noclip together
			T.ghost = v
			setFly(v)
			setNoclip(v)
			return
		end
		if k == "party" then -- preset: spin + disco + pogo together
			T.party = v
			for _, kk in ipairs({ "spin", "disco", "pogo" }) do FX.setTroll(kk, v) end
			return
		end
		T[k] = v
		if v then
			if k == "tornado" then T.spin = false end
			if k == "spin" then T.tornado = false end
		end
		if (k == "spin" or k == "tornado") and not (T.spin or T.tornado) then stopSpin() end
		if k == "freeze" and not v then
			local r = myRoot()
			if r then r.Anchored = false end
		elseif k == "spectate" and not v then
			local h = myHum()
			if h and camera then camera.CameraSubject = h end
		elseif k == "sit" and not v then
			local h = myHum()
			if h then h.Sit = false end
		elseif k == "lay" and not v then
			local h, r = myHum(), myRoot()
			if h then h.PlatformStand = false end
			if r then
				local _, yaw = r.CFrame:ToOrientation()
				r.CFrame = CFrame.new(r.Position + Vector3.new(0, 2, 0)) * CFrame.Angles(0, yaw, 0)
			end
		elseif k == "headspin" and not v then
			local n = findNeck()
			if n and neckOrig then n.C0 = neckOrig end
			neckOrig = nil
		elseif k == "lag" and not v then
			local r = myRoot()
			if r and not T.freeze then r.Anchored = false end
		elseif k == "moonwalk" and not v then
			local h = myHum()
			if h then h.AutoRotate = true end
		elseif k == "fovpulse" and not v then
			local c = Workspace.CurrentCamera
			if c then c.FieldOfView = (FX.camFovOn and CONFIG.CamFov) or 70 end
		elseif k == "rainbow" then
			local c = player.Character
			if v and c then
				rainbowOrig = {}
				for _, d in ipairs(c:GetDescendants()) do
					if d:IsA("BasePart") then rainbowOrig[d] = d.Color end
				end
			elseif not v and rainbowOrig then
				for part, col in pairs(rainbowOrig) do
					if part.Parent then part.Color = col end
				end
				rainbowOrig = nil
			end
		elseif k == "ragdoll" and not v then
			local h = myHum()
			if h then h:ChangeState(Enum.HumanoidStateType.GettingUp) end
		elseif k == "chaos" and not v then
			local h = myHum()
			if h and chaosOrig then h.WalkSpeed = chaosOrig end
			chaosOrig = nil
		elseif k == "xray" then
			if v then
				xrayOrig = {}
				for _, d in ipairs(Workspace:GetDescendants()) do
					if d:IsA("BasePart") and d.Transparency < 0.5 and not d:IsDescendantOf(camera) then
						local m = d:FindFirstAncestorOfClass("Model")
						if not (m and m:FindFirstChildOfClass("Humanoid")) then
							xrayOrig[d] = d.LocalTransparencyModifier
							d.LocalTransparencyModifier = 0.65
						end
					end
				end
			elseif xrayOrig then
				for part, old in pairs(xrayOrig) do
					if part.Parent then part.LocalTransparencyModifier = old end
				end
				xrayOrig = nil
			end
		elseif k == "freecam" then
			local c = Workspace.CurrentCamera
			local r = myRoot()
			if v and c then
				fc.pos = c.CFrame.Position
				local look = c.CFrame.LookVector
				fc.yaw = math.atan2(-look.X, -look.Z)
				fc.pitch = math.asin(look.Y)
				fc.wasAnchored = r and r.Anchored or false
				if r then r.Anchored = true end
				c.CameraType = Enum.CameraType.Scriptable
			elseif c then
				c.CameraType = Enum.CameraType.Custom
				local h = myHum()
				if h then c.CameraSubject = h end
				if r and not T.freeze and not fc.wasAnchored then r.Anchored = false end
			end
		elseif k == "snail" and not v then
			local h = myHum()
			if h and snailOrig then h.WalkSpeed = snailOrig end
			snailOrig = nil
		elseif k == "fisheye" and not v then
			local c = Workspace.CurrentCamera
			if c then c.FieldOfView = (FX.camFovOn and CONFIG.CamFov) or 70 end
		elseif k == "stilts" and not v then
			local h = myHum()
			if h and stiltOrig then h.HipHeight = stiltOrig end
			stiltOrig = nil
		elseif k == "hilite" and not v then
			if hiliteObj then hiliteObj.Adornee = nil end
		elseif k == "follow" and not v then
			local h, r = myHum(), myRoot()
			if h and r then h:MoveTo(r.Position) end
		elseif k == "ice" then
			if v then applyIce() else removeIce() end
		elseif k == "trail" and not v then
			removeTrail()
		elseif k == "zoomfar" then
			if v then
				zoomOrig = zoomOrig or player.CameraMaxZoomDistance
				player.CameraMaxZoomDistance = 500
			elseif zoomOrig then
				player.CameraMaxZoomDistance = zoomOrig
				zoomOrig = nil
			end
		elseif k == "disco" and not v then
			Lighting.ColorShift_Top = discoOrig.top
			Lighting.ColorShift_Bottom = discoOrig.bottom
		end
	end

	local angle, headAng, discoT = 0, 0, 0
	local shuffleT, lastWob = 0, 0
	RunService.Heartbeat:Connect(function(dt)
		local root, hum = myRoot(), myHum()
		if not root then return end
		if T.freeze then root.Anchored = true end
		if T.ice and iceChar ~= player.Character then applyIce() end
		if T.trail and (not trailObj or not trailObj.Parent or trailObj.Parent ~= root) then removeTrail() makeTrail(root) end
		if T.ragdoll and hum then hum:ChangeState(Enum.HumanoidStateType.Physics) end
		if T.stilts and hum then
			stiltOrig = stiltOrig or hum.HipHeight
			hum.HipHeight = 8 -- your character is yours, so other players see you on stilts
		end
		if T.bounce then
			bounceT += dt
			if bounceT > 0.8 then
				bounceT = 0
				local v = root.AssemblyLinearVelocity
				root.AssemblyLinearVelocity = Vector3.new(v.X, 55, v.Z)
			end
		end
		if T.circles and hum then
			circAng += dt * 2
			hum:Move(Vector3.new(math.cos(circAng), 0, math.sin(circAng)), false)
		end
		if T.invisible and player.Character then
			-- you still see yourself, a little see-through
			for _, d in ipairs(player.Character:GetDescendants()) do
				if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then d.LocalTransparencyModifier = 0.65 end
			end
		end
		if T.snail and hum and not walkOn then
			snailOrig = snailOrig or hum.WalkSpeed
			hum.WalkSpeed = 4
		end
		if T.antivoid then
			local floorY = Workspace.FallenPartsDestroyHeight
			if hum and hum.FloorMaterial ~= Enum.Material.Air and root.Position.Y > floorY + 60 then lastSafe = root.CFrame end
			if lastSafe and root.Position.Y < floorY + 30 then
				root.CFrame = lastSafe + Vector3.new(0, 4, 0)
				root.AssemblyLinearVelocity = Vector3.zero
			end
		end
		if T.timelapse then Lighting.ClockTime = (Lighting.ClockTime + dt * 0.5) % 24 end
		if T.float then
			local v = root.AssemblyLinearVelocity
			if v.Y < 0 then root.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z) end
		end
		if T.reverse and hum and hum.MoveDirection.Magnitude > 0.1 then hum:Move(-hum.MoveDirection, false) end
		if T.chaos and hum and not walkOn then
			chaosT += dt
			if chaosT > 0.4 then
				chaosT = 0
				chaosOrig = chaosOrig or hum.WalkSpeed
				hum.WalkSpeed = math.random(6, 90)
			end
		end
		if T.lag and not T.freeze then root.Anchored = (os.clock() % 0.5) < 0.18 end
		if T.moonwalk and hum and hum.MoveDirection.Magnitude > 0.1 then
			hum.AutoRotate = false
			root.CFrame = CFrame.lookAt(root.Position, root.Position - hum.MoveDirection)
		end
		if T.pogo and hum and hum.FloorMaterial ~= Enum.Material.Air then
			local v = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(v.X, 55, v.Z)
		end
		if T.shuffle then
			shuffleT += dt
			if shuffleT > 0.6 then
				shuffleT = 0
				root.CFrame = root.CFrame + Vector3.new(math.random(-12, 12), 0, math.random(-12, 12))
			end
		end
		if T.wobble then
			local a = math.sin(os.clock() * 6) * 0.35
			root.CFrame = root.CFrame * CFrame.Angles(0, 0, a - lastWob)
			lastWob = a
		end
		if T.rainbow and rainbowOrig then
			local col = Color3.fromHSV((os.clock() * 0.4) % 1, 1, 1)
			for part in pairs(rainbowOrig) do
				if part.Parent then part.Color = col end
			end
		end
		if T.spin or T.tornado then ensureSpin(root, hum) end
		if T.tornado then
			local v = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(v.X, math.cos(os.clock() * 2) * 28, v.Z)
		end
		if T.bhop and hum and hum.FloorMaterial ~= Enum.Material.Air and hum.MoveDirection.Magnitude > 0 then hum.Jump = true end
		if T.sit and hum then hum.Sit = true end
		if T.lay and hum then
			hum.PlatformStand = true
			local _, yaw = root.CFrame:ToOrientation()
			root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(math.rad(-90), 0, 0)
		end
		if T.jitter then
			root.CFrame = root.CFrame * CFrame.new((math.random() - 0.5) * 0.6, 0, (math.random() - 0.5) * 0.6) * CFrame.Angles(0, (math.random() - 0.5) * 0.4, 0)
		end
		if T.headspin then
			local n = findNeck()
			if n then
				if not neckOrig then neckOrig = n.C0 end
				headAng += dt * 12
				n.C0 = neckOrig * CFrame.Angles(0, headAng, 0)
			end
		end
		if T.disco then
			discoT += dt
			if discoT > 0.15 then
				discoT = 0
				Lighting.ColorShift_Top = Color3.fromHSV(math.random(), 1, 1)
				Lighting.ColorShift_Bottom = Color3.fromHSV(math.random(), 1, 1)
			end
		end
		local ch = (T.circle or T.stalk or T.stare or T.ride or T.hover or T.satellite or T.follow or T.hilite or T.spectate) and pickedChar() or nil
		if T.hilite then
			if not hiliteObj then
				hiliteObj = Instance.new("Highlight")
				hiliteObj.FillColor = Color3.fromRGB(80, 220, 255)
				hiliteObj.OutlineColor = Color3.fromRGB(80, 220, 255)
				hiliteObj.FillTransparency = 0.6
				hiliteObj.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				hiliteObj.Parent = gui
			end
			hiliteObj.Adornee = ch
		elseif hiliteObj and hiliteObj.Adornee then
			hiliteObj.Adornee = nil
		end
		if ch then
			local tr = ch.HumanoidRootPart
			if T.circle then
				local c = tr.Position
				angle += dt * 3
				local r = CONFIG.CircleRadius
				root.CFrame = CFrame.lookAt(c + Vector3.new(math.cos(angle) * r, 0, math.sin(angle) * r), c)
				root.AssemblyLinearVelocity = Vector3.zero
			elseif T.stalk then
				root.CFrame = tr.CFrame * CFrame.new(0, 0, 3.5)
				root.AssemblyLinearVelocity = Vector3.zero
			elseif T.hover then
				root.CFrame = CFrame.lookAt(tr.Position + Vector3.new(0, 9, 0), tr.Position)
				root.AssemblyLinearVelocity = Vector3.zero
			elseif T.satellite then
				angle += dt * 1.5
				local c = tr.Position
				root.CFrame = CFrame.lookAt(c + Vector3.new(math.cos(angle) * 14, 6 + math.sin(angle * 2) * 3, math.sin(angle) * 14), c)
				root.AssemblyLinearVelocity = Vector3.zero
			elseif T.ride then
				root.CFrame = tr.CFrame * CFrame.new(0, 3.2, 0)
				root.AssemblyLinearVelocity = Vector3.zero
			elseif T.stare then
				local tp = tr.Position
				root.CFrame = CFrame.lookAt(root.Position, Vector3.new(tp.X, root.Position.Y, tp.Z))
			end
			if T.follow and hum then
				if (tr.Position - root.Position).Magnitude > 5 then hum:MoveTo(tr.Position) else hum:MoveTo(root.Position) end
			end
			if T.spectate then
				local h = ch:FindFirstChildOfClass("Humanoid")
				if h and camera and camera.CameraSubject ~= h then camera.CameraSubject = h end
			end
		end
	end)

	RunService:BindToRenderStep("AimAssistTroll", Enum.RenderPriority.Camera.Value + 3, function()
		local cam = Workspace.CurrentCamera
		if not cam then return end
		if T.shake then
			cam.CFrame = cam.CFrame * CFrame.Angles(math.rad(math.random(-10, 10) / 10), math.rad(math.random(-10, 10) / 10), 0)
		end
		if T.drunk then
			local t = os.clock()
			cam.CFrame = cam.CFrame * CFrame.Angles(math.sin(t * 0.9) * 0.05, math.sin(t * 1.3) * 0.06, math.sin(t * 1.1) * 0.18)
		end
		if T.dizzy then cam.CFrame = cam.CFrame * CFrame.Angles(0, (os.clock() * 1.4) % (math.pi * 2), 0) end
		if T.fovpulse and not FX.camFovOn then cam.FieldOfView = 70 + math.sin(os.clock() * 3) * 25 end
		if T.tilt then cam.CFrame = cam.CFrame * CFrame.Angles(0, 0, math.rad(18)) end
		if T.fisheye and not FX.camFovOn and not T.fovpulse then cam.FieldOfView = 120 end
		if T.backcam then cam.CFrame = cam.CFrame * CFrame.Angles(0, math.pi, 0) end
		if T.flip then cam.CFrame = cam.CFrame * CFrame.Angles(0, 0, math.pi) end
	end)

	-- freecam: right mouse drag = look, WASD = move, E / Q = up / down, shift = faster (pc)
	UserInputService.InputChanged:Connect(function(input)
		if T.freecam and input.UserInputType == Enum.UserInputType.MouseMovement
			and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			fc.yaw -= input.Delta.X * 0.004
			fc.pitch = math.clamp(fc.pitch - input.Delta.Y * 0.004, -1.5, 1.5)
		end
	end)
	RunService:BindToRenderStep("AimAssistFreecam", Enum.RenderPriority.Camera.Value + 4, function(dt)
		if not T.freecam then return end
		local cam = Workspace.CurrentCamera
		if not cam then return end
		local rot = CFrame.Angles(0, fc.yaw, 0) * CFrame.Angles(fc.pitch, 0, 0)
		local dir = Vector3.zero
		local function down(k) return UserInputService:IsKeyDown(k) end
		if down(Enum.KeyCode.W) then dir += rot.LookVector end
		if down(Enum.KeyCode.S) then dir -= rot.LookVector end
		if down(Enum.KeyCode.D) then dir += rot.RightVector end
		if down(Enum.KeyCode.A) then dir -= rot.RightVector end
		if down(Enum.KeyCode.E) then dir += Vector3.yAxis end
		if down(Enum.KeyCode.Q) then dir -= Vector3.yAxis end
		local speed = down(Enum.KeyCode.LeftShift) and 120 or 40
		fc.pos += dir * speed * dt
		cam.CFrame = CFrame.new(fc.pos) * rot
	end)

	-- waypoints, victim cycling, camera reset, spawn
	local waypoints = {}
	FX.saveWaypoint = function(i)
		local r = myRoot()
		if r then waypoints[i] = r.CFrame end
	end
	FX.goWaypoint = function(i)
		local r = myRoot()
		if r and waypoints[i] then r.CFrame = waypoints[i] end
	end
	FX.waypointSet = function(i) return waypoints[i] ~= nil end
	FX.cycleVictim = function(dir)
		local list = {}
		for _, pl in ipairs(Players:GetPlayers()) do
			if pl ~= player and pl.Character and pl.Character:FindFirstChild("HumanoidRootPart") then list[#list + 1] = pl.Name end
		end
		if #list == 0 then return end
		local idx = table.find(list, victimRef.name) or 0
		idx = ((idx - 1 + dir) % #list) + 1
		victimRef.name = list[idx]
		if FX.onVictimChanged then FX.onVictimChanged() end
	end
	FX.resetCamera = function()
		local c = Workspace.CurrentCamera
		local h = myHum()
		if c then
			c.CameraType = Enum.CameraType.Custom
			c.FieldOfView = 70
			if h then c.CameraSubject = h end
		end
	end
	FX.goSpawn = function()
		local sp = Workspace:FindFirstChildWhichIsA("SpawnLocation", true)
		local r = myRoot()
		if sp and r then r.CFrame = sp.CFrame + Vector3.new(0, 5, 0) end
	end
	FX.info = function()
		local r = myRoot()
		local p = r and r.Position or Vector3.zero
		local line = "victim: none (auto)"
		local vc = pickedChar()
		if vc then
			local vh = vc:FindFirstChildOfClass("Humanoid")
			local pl = Players:GetPlayerFromCharacter(vc)
			local tool = vc:FindFirstChildOfClass("Tool")
			local d = r and (vc.HumanoidRootPart.Position - p).Magnitude or 0
			line = string.format("victim: %s | hp %d | %dm | team %s%s", vc.Name, vh and math.floor(vh.Health) or 0, math.floor(d),
				(pl and pl.Team and pl.Team.Name) or "none", tool and (" | holding " .. tool.Name) or "")
		elseif victimRef.name then
			line = "victim: " .. victimRef.name .. " (not here right now)"
		end
		local near = {}
		for _, pl in ipairs(Players:GetPlayers()) do
			local rr = pl ~= player and pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
			if rr then near[#near + 1] = { pl.Name, (rr.Position - p).Magnitude } end
		end
		table.sort(near, function(x, y) return x[2] < y[2] end)
		local nearText = {}
		for i = 1, math.min(3, #near) do nearText[i] = near[i][1] .. " " .. math.floor(near[i][2]) .. "m" end
		return string.format("pos %d, %d, %d\nplayers %d / %d   ping %d ms\nnearest: %s\n%s",
			p.X, p.Y, p.Z, #Players:GetPlayers(), Players.MaxPlayers, math.floor(player:GetNetworkPing() * 1000),
			#nearText > 0 and table.concat(nearText, ", ") or "nobody", line)
	end
	local function blink()
