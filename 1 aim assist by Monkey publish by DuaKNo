	Lighting.FogEnd = 100000
	Lighting.GlobalShadows = false
	Lighting.Ambient = Color3.fromRGB(178, 178, 178)
	Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)
end
function FX.setFullbright(on)
	FX.fullbrightOn = on
	if on then
		FX.lightSaved = FX.lightSaved or {
			Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime, FogEnd = Lighting.FogEnd,
			GlobalShadows = Lighting.GlobalShadows, Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient,
		}
		FX.fullbrightWriting = true
		applyFullbright()
		FX.fullbrightWriting = false
	elseif FX.lightSaved then
		FX.fullbrightWriting = true
		for k, v in pairs(FX.lightSaved) do Lighting[k] = v end
		FX.fullbrightWriting = false
		FX.lightSaved = nil
	end
	if FX.onFullbrightChanged then FX.onFullbrightChanged() end
end
