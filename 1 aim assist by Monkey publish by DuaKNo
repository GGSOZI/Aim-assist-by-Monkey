		BindMacro = { kind = "key" },
	}
	local BUTTON_NAMES = { "lock", "fly", "up", "down", "next", "noclip", "macro" }

	local function clamp(n, lo, hi)
		return math.max(lo, math.min(hi, n))
	end

	local function sanitize(data)
		if type(data) ~= "table" or type(data.settings) ~= "table" then return nil end
		local clean = { settings = {}, positions = {}, lockIndex = 1 }

		for key, rule in pairs(SCHEMA) do
			local v = data.settings[key]
			if rule.kind == "bool" then
				if type(v) == "boolean" then clean.settings[key] = v end
			elseif rule.kind == "num" then
				if type(v) == "number" and v == v then
					clean.settings[key] = math.floor(clamp(v, rule.min, rule.max) + 0.5)
				end
			elseif rule.kind == "enum" then
				if type(v) == "string" and table.find(rule.list, v) then clean.settings[key] = v end
			elseif rule.kind == "str" then
				if type(v) == "string" and #v <= rule.max and not string.find(v, "%c") then clean.settings[key] = v end
			elseif rule.kind == "key" then
				if type(v) == "string" and #v <= 20 and pcall(function() return Enum.KeyCode[v] end) then clean.settings[key] = v end
			end
		end

		if type(data.lockIndex) == "number" and data.lockIndex == data.lockIndex then
			clean.lockIndex = math.floor(clamp(data.lockIndex, 1, 4))
		end

		if type(data.positions) == "table" then
			for _, name in ipairs(BUTTON_NAMES) do
				local p = data.positions[name]
				if type(p) == "table" and type(p.x) == "number" and type(p.y) == "number"
					and p.x == p.x and p.y == p.y then
					clean.positions[name] = {
						x = math.floor(clamp(p.x, -3000, 6000)),
						y = math.floor(clamp(p.y, -3000, 6000)),
					}
				end
			end
		end
		return clean
	end

	local function keyFor(plr, payload)
		local slot = type(payload) == "table" and payload.slot
		if type(slot) == "number" and slot >= 1 and slot <= 5 then
			return "u_" .. plr.UserId .. "_p" .. math.floor(slot)
		end
		return "u_" .. plr.UserId
	end

	local lastSave = {}

	remote.OnServerInvoke = function(plr, action, payload)
		local key = keyFor(plr, payload)

		if action == "load" then
			local ok, data = pcall(function() return store:GetAsync(key) end)
			if ok then return sanitize(data) end
			return nil

		elseif action == "save" then
			local now = os.clock()
			if lastSave[plr] and now - lastSave[plr] < 6 then
				return "wait a few seconds"
			end
			lastSave[plr] = now
			local clean = sanitize(payload)
			if not clean then return "invalid data" end
			local ok = pcall(function() store:SetAsync(key, clean) end)
			return ok

		elseif action == "reset" then
			local ok = pcall(function() store:RemoveAsync(key) end)
			return ok
		end
		return nil
	end

	Players.PlayerRemoving:Connect(function(plr)
		lastSave[plr] = nil
	end)
end

do -- ===== SUIT, INVISIBLE AND ANNOUNCEMENTS =====
	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")

	local remote = Instance.new("RemoteEvent")
	remote.Name = "MonkeySkin"
	remote.Parent = ReplicatedStorage

	local SHIRT_ID, PANTS_ID, FACE_ID, MASK_ACCESSORY_ID = 0, 0, 0, 0
	local RED, BLUE = Color3.fromRGB(190, 30, 35), Color3.fromRGB(35, 60, 150)

	local state, last = {}, {}

	local function apply(plr, on)
		local char = plr.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum then return end
		local st = state[plr]
		if not st then return end
		if on then
			local ok, desc = pcall(function() return hum:GetAppliedDescription() end)
			if not ok or not desc then return end
			if not st.original then st.original = desc:Clone() end
			desc.HeadColor, desc.TorsoColor = RED, RED
			desc.LeftArmColor, desc.RightArmColor = RED, RED
			desc.LeftLegColor, desc.RightLegColor = BLUE, BLUE
			if SHIRT_ID ~= 0 then desc.Shirt = SHIRT_ID end
			if PANTS_ID ~= 0 then desc.Pants = PANTS_ID end
			if FACE_ID ~= 0 then desc.Face = FACE_ID end
			if MASK_ACCESSORY_ID ~= 0 then
				desc.HatAccessory = (desc.HatAccessory ~= "" and (desc.HatAccessory .. ",") or "") .. tostring(MASK_ACCESSORY_ID)
			end
			pcall(function() hum:ApplyDescription(desc) end)
		elseif st.original then
			pcall(function() hum:ApplyDescription(st.original) end)
			st.original = nil
		end
	end

	local function setHidden(plr, on)
		local char = plr.Character
		local st = state[plr]
		if not char or not st then return end
		st.hidden = on
		local hum = char:FindFirstChildOfClass("Humanoid")
		if on then
			st.orig = st.orig or {}
			for _, d in ipairs(char:GetDescendants()) do
				if (d:IsA("BasePart") and d.Name ~= "HumanoidRootPart") or d:IsA("Decal") then
					if st.orig[d] == nil then st.orig[d] = d.Transparency end
					d.Transparency = 1
				end
			end
			if hum then hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
		else
			if st.orig then
				for d, tr in pairs(st.orig) do
					if d.Parent then d.Transparency = tr end
				end
				st.orig = nil
			end
			if hum then hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer end
		end
	end

	remote.OnServerEvent:Connect(function(plr, action)
		if action ~= "on" and action ~= "off" and action ~= "hide" and action ~= "show" then return end
		local now = os.clock()
		if last[plr] and now - last[plr] < 2 then return end
		last[plr] = now
		state[plr] = state[plr] or {}
		if action == "hide" or action == "show" then
			setHidden(plr, action == "hide")
			return
		end
		state[plr].on = (action == "on")
		apply(plr, state[plr].on)
	end)

	local function hook(plr)
		plr.CharacterAdded:Connect(function(char)
			local st = state[plr]
			if st and (st.on or st.hidden) then
				st.original = nil
				st.orig = nil
				char:WaitForChild("Humanoid")
				task.wait(1)
				if st.on then apply(plr, true) end
				if st.hidden then setHidden(plr, true) end
			end
		end)
	end
	-- announcements: only the game creator (or user ids you put in ADMIN_IDS, e.g. { 12345 }) can send one, everybody sees it
	local TextService = game:GetService("TextService")
	local ADMIN_IDS = {}
	local announce = Instance.new("RemoteEvent")
	announce.Name = "MonkeyAnnounce"
	announce.Parent = ReplicatedStorage
	local lastAnn = 0
	announce.OnServerEvent:Connect(function(plr, text)
		if type(text) ~= "string" then return end
		if plr.UserId ~= game.CreatorId and not table.find(ADMIN_IDS, plr.UserId) then return end
		if os.clock() - lastAnn < 5 then return end
		lastAnn = os.clock()
		text = string.sub(text, 1, 120)
		local ok, res = pcall(function()
			return TextService:FilterStringAsync(text, plr.UserId):GetNonChatStringForBroadcastAsync()
		end)
		if ok and res and res ~= "" then announce:FireAllClients(res, plr.DisplayName) end
	end)

	Players.PlayerAdded:Connect(hook)
	for _, plr in ipairs(Players:GetPlayers()) do hook(plr) end
	Players.PlayerRemoving:Connect(function(plr)
		state[plr], last[plr] = nil, nil
	end)
end
