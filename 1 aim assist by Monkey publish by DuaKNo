			return
		end
		local want = ((CONFIG.Macro and FX.macroHeld) or FX.macroBtnHeld or FX.macroLatch) and not FX.safeMode
		if not want and not FX.macroActive then return end

		if want and not FX.macroActive then
			base = (FX.sprinting and FX.sprintBase) or (walkOn and CONFIG.WalkSpeed) or hum.WalkSpeed
			rs, legF, lastSet = base, 1, nil
			FX.macroActive = true
		end

		-- target speed: the run speed while wanted, back to normal when released (smooth both ways)
		local target = base
		if want then
			target = CONFIG.MacroSpeed
			pulseT += dt
			if CONFIG.MacroPulse and (pulseT % 0.2) > 0.12 then target = math.max(base, target * 0.55) end
		end
		local moving = hum.MoveDirection.Magnitude > 0.1
		-- speed builds up in about a third of a second and fades out slightly slower, like a real sprint
		rs += (target - rs) * (1 - math.exp(-dt * (want and 7 or 9)))

		local cur = hum.WalkSpeed
		if lastSet and cur < lastSet - 0.5 then fought = os.clock() end -- the game keeps pushing the walk speed back down
		hum.WalkSpeed = rs
		lastSet = rs
		FX.macroFought = want and os.clock() - fought < 1.5

		-- legs: faster steps the faster you go (smoothed so it never jumps)
		local legTarget = 1
		if moving then legTarget = math.clamp(rs / math.max(base, 8), 1, 3.5) * (CONFIG.RunLegs / 100) end
		legF += (legTarget - legF) * (1 - math.exp(-dt * 8))
		-- when the game accepts the walk speed its own animation script already speeds the legs up; touching it too would make it jitter
		local ownLegs = FX.macroFought or CONFIG.RunLegs ~= 100
		if ownLegs and (moving or math.abs(legF - 1) > 0.02) then
			for _, tr in ipairs(legTracks(hum)) do tr:AdjustSpeed(legF) end
		end

		-- the game refuses the walk speed: push with physics (collides with walls, no teleporting), stop short of walls
		if FX.macroFought and moving then
			local st = hum:GetState()
			if st ~= Enum.HumanoidStateType.Seated and st ~= Enum.HumanoidStateType.Physics and st ~= Enum.HumanoidStateType.Ragdoll
				and st ~= Enum.HumanoidStateType.FallingDown and st ~= Enum.HumanoidStateType.PlatformStanding then
				local d = hum.MoveDirection.Unit
				local speed = rs
				wallParams.FilterDescendantsInstances = { char }
				local hit = Workspace:Raycast(root.Position, d * math.max(4, speed * 0.12), wallParams)
				-- only real walls stop you; ramps and steps (surfaces that lean) do not
				if hit and math.abs(hit.Normal.Y) < 0.55 then speed = math.min(speed, math.max(0, (hit.Distance - 2.2) / 0.12)) end
				local v = root.AssemblyLinearVelocity
				local along = v.X * d.X + v.Z * d.Z -- speed you already have in the walking direction
				if along < speed then root.AssemblyLinearVelocity = Vector3.new(d.X * speed, v.Y, d.Z * speed) end
			end
		end

		-- fully back to normal: give everything back
		if not want and math.abs(rs - base) < 0.6 and math.abs(legF - 1) < 0.03 then
			hum.WalkSpeed = base
			for _, tr in ipairs(legTracks(hum)) do tr:AdjustSpeed(1) end
			FX.macroActive, FX.macroFought = false, false
			rs, legF, lastSet = base, 1, nil
		end
	end)
end

