-- queue entries are player names, or "npc:N" for NPCs picked in the list
local npcModels, npcIds, npcCount = {}, setmetatable({}, { __mode = "k" }), 0
local function npcIdFor(model)
	local id = npcIds[model]
	if not id then
		npcCount += 1
		id = "npc:" .. npcCount
		npcIds[model] = id
		npcModels[id] = model
	end
	return id
end
-- a character that died stays "dead" (never targeted again) until it really gets back up, plus a short grace period
local deadMem = setmetatable({}, { __mode = "k" })
local KNOCKED_FLAGS = { "Downed", "Knocked", "KnockedOut", "KO", "Ragdoll", "Ragdolled", "Dead", "IsDead" }
-- "knocked" = alive on paper but down: humanoid in a ragdoll state, or the game marks it with a flag
local function isKnocked(model, hum)
	local st = hum:GetState()
	if st == Enum.HumanoidStateType.Ragdoll or st == Enum.HumanoidStateType.Physics then return true end
	for _, n in ipairs(KNOCKED_FLAGS) do
		if model:GetAttribute(n) == true or hum:GetAttribute(n) == true then return true end
		local v = model:FindFirstChild(n)
		if v and v:IsA("BoolValue") and v.Value then return true end
	end
	return false
end
local function isDead(model)
	local hum = model and model:FindFirstChildOfClass("Humanoid")
	if not hum then return true end
	if CONFIG.SkipKnocked and model ~= (player and player.Character) and isKnocked(model, hum) then return true end
	if hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead then
		deadMem[model] = os.clock()
		return true
	end
	local t = deadMem[model]
	if t then
		if os.clock() - t < 1.5 then return true end
		deadMem[model] = nil
	end
	return false
end
-- a real character: a Model with a living Humanoid, a Head and a body part. props / loose parts never pass
local function isCharacter(model)
	if not model or not model:IsA("Model") then return false end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum then return false end
	if not model:FindFirstChild("Head") or not model:FindFirstChild("HumanoidRootPart") then return false end
	return true
end
local function queueEntry(name)
	if name and string.sub(name, 1, 4) == "npc:" then
		local m = npcModels[name]
		return { Character = (m and m.Parent) and m or nil }
	end
	return name and Players:FindFirstChild(name) or nil
end

-- ===== TRACK HUMANOIDS (cheaper than scanning Workspace every frame) =====
local humanoids = {}
local function track(d)
	if d:IsA("Humanoid") then
		humanoids[d] = true
		-- the Died event marks the model dead at once, before health finishes replicating
		d.Died:Connect(function()
			local m = d.Parent
			if m then deadMem[m] = os.clock() end
		end)
	end
end
for _, d in ipairs(Workspace:GetDescendants()) do track(d) end
Workspace.DescendantAdded:Connect(track)
Workspace.DescendantRemoving:Connect(function(d) humanoids[d] = nil end)

