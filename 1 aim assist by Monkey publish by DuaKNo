				local x, y = rel:Dot(r) / range * half, -rel:Dot(f) / range * half
				local mag = math.sqrt(x * x + y * y)
				if mag > half - 3 then x, y = x / mag * (half - 3), y / mag * (half - 3) end
				used += 1
