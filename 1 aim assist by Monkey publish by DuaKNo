	local function legTracks(hum)
		local animator = hum:FindFirstChildOfClass("Animator")
		if not animator then return {} end
		local named, other = {}, {}
		local grounded = hum.FloorMaterial ~= Enum.Material.Air
		for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
			local n = string.lower(tr.Name)
			if string.find(n, "run") or string.find(n, "walk") then
				named[#named + 1] = tr
			elseif grounded and tr.Looped and tr.Priority == Enum.AnimationPriority.Movement and not string.find(n, "idle") and not string.find(n, "jump") and not string.find(n, "fall") and not string.find(n, "climb") and not string.find(n, "swim") then
				other[#other + 1] = tr
			end
		end
		return #named > 0 and named or other
	end

