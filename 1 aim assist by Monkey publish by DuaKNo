	valueLabel.TextXAlignment = Enum.TextXAlignment.Right
	valueLabel.TextColor3 = GREEN
	valueLabel.Font = FONT
	valueLabel.TextSize = 14
	valueLabel.Parent = holder

	local track = Instance.new("Frame")
	track.Position = UDim2.fromOffset(10, 28)
	track.Size = UDim2.new(1, -20, 0, 4)
	track.BackgroundColor3 = BG
	track.BorderSizePixel = 0
	track.Parent = holder
	addStroke(track)

	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = GREEN
	fill.BorderSizePixel = 0
	fill.Parent = track

	local function set(value)
		value = math.clamp(math.floor(value + 0.5), min, max)
		CONFIG[key] = value
		fill.Size = UDim2.fromScale((value - min) / (max - min), 1)
		valueLabel.Text = tostring(value)
		if onChange then
			local ok, err = pcall(onChange)
			if not ok then FX.logError("slider: " .. name, err) end
		end
	end
	local function fromX(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		set(min + a * (max - min))
	end

	local sliding = false
	holder.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2 and FX.toggleFav then
			FX.toggleFav(name)
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			page.ScrollingEnabled = false -- so the menu does not scroll while you slide
			fromX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			fromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if sliding and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			sliding = false
			page.ScrollingEnabled = true
		end
	end)
	set(CONFIG[key])
	FX.ui[#FX.ui + 1] = function() set(CONFIG[key]) end
end

