-- ===== SPIDER MODE: web swing + wall climb (physics on your own character, so everyone sees you move) =====
do
	local S = FX.spidey
	local webBtn = makeRound("Web", 52)
	webBtn.Name = "WebButton"
	webBtn.Position = UDim2.new(1, -300, 1, -230)
	webBtn.Visible = false

	S.swing = nil -- { part, att, pos, len }
	S.clinging = false
	S.suitOrig = nil
	S.wallParams = RaycastParams.new()
	S.wallParams.FilterType = Enum.RaycastFilterType.Exclude

	function S.root() return player.Character and player.Character:FindFirstChild("HumanoidRootPart") end
	function S.hum() return player.Character and player.Character:FindFirstChildOfClass("Humanoid") end

	function S.stopSwing()
		if S.swing then
			S.swing.part:Destroy()
			S.swing.att:Destroy()
			S.swing = nil
		end
	end
	function S.startSwing()
		local root = S.root()
		local cam = Workspace.CurrentCamera
		if not (S.on and root and cam) then return end
		S.wallParams.FilterDescendantsInstances = { player.Character }
		local hit = Workspace:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * 220, S.wallParams)
		if not hit then
			FX.notify("no web target: aim at a building or wall", false)
			return
		end
		S.stopSwing()
		local a = Instance.new("Part")
		a.Anchored, a.CanCollide, a.CanQuery, a.CanTouch = true, false, false, false
		a.Transparency = 1
		a.Size = Vector3.one * 0.2
		a.Position = hit.Position
		a.Parent = Workspace
		local a0 = Instance.new("Attachment")
		a0.Parent = a
		local a1 = Instance.new("Attachment")
		a1.Parent = root
		local beam = Instance.new("Beam")
		beam.Attachment0, beam.Attachment1 = a0, a1
		beam.Width0, beam.Width1 = 0.12, 0.12
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.Color = ColorSequence.new(Color3.new(1, 1, 1))
		beam.Parent = a
		S.swing = { part = a, att = a1, pos = hit.Position, len = math.max((root.Position - hit.Position).Magnitude * 0.9, 8) }
	end

	webBtn.MouseButton1Down:Connect(S.startSwing)
	webBtn.MouseButton1Up:Connect(S.stopSwing)
	webBtn.MouseLeave:Connect(S.stopSwing)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and not FX.rebinding and input.KeyCode == FX.kc("BindWeb") then S.startSwing() end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == FX.kc("BindWeb") then S.stopSwing() end
	end)

	function S.setSuit(on)
		S.suit = on
		-- with the server script installed the SERVER changes your look, so everybody sees it
		local skin = game:GetService("ReplicatedStorage"):FindFirstChild("MonkeySkin")
		if skin then
			skin:FireServer(on and "on" or "off")
			return
		end
		if on then FX.notify("server script missing: the suit is only on your screen (see the bottom of the file)", false) end
		local c = player.Character
		if on and c then
			S.suitOrig = {}
			for _, d in ipairs(c:GetDescendants()) do
				if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
					S.suitOrig[d] = d.Color
					local n = d.Name
					if n:find("Leg") or n:find("Foot") then
						d.Color = Color3.fromRGB(35, 60, 150)
					elseif n:find("Arm") or n:find("Hand") or n:find("Torso") or n == "Head" then
						d.Color = Color3.fromRGB(190, 30, 35)
					end
				end
			end
		elseif S.suitOrig then
			for part, col in pairs(S.suitOrig) do
				if part.Parent then part.Color = col end
			end
			S.suitOrig = nil
		end
	end
	FX.setSuit = S.setSuit

	FX.setSpidey = function(on)
		if FX.safeMode and on then return end
		S.on = on
		webBtn.Visible = on
		if S.autoSuit then S.setSuit(on) end -- becoming spider-man also changes the skin
		if not on then
			S.stopSwing()
			S.clinging = false
		end
	end
	FX.spiderLeap = function()
		local root = S.root()
		if root then root.AssemblyLinearVelocity = root.CFrame.LookVector * 60 + Vector3.new(0, 90, 0) end
	end
	RunService.Heartbeat:Connect(function(dt)
		if not S.on then return end
		local root, hum = S.root(), S.hum()
		if not root or not hum or hum.Health <= 0 then
			S.stopSwing()
			return
		end
		if S.swing then
			local to = S.swing.pos - root.Position
			local dist = to.Magnitude
			if dist > 0.1 then
				local dir = to / dist
				local v = root.AssemblyLinearVelocity
				if dist > S.swing.len then
					local vr = v:Dot(dir)
					if vr < 0 then v -= dir * vr end -- rope stops you moving away
					root.CFrame = root.CFrame + dir * (dist - S.swing.len) * 0.6
				end
				v += hum.MoveDirection * 45 * dt -- steer while swinging
				root.AssemblyLinearVelocity = v
				hum:ChangeState(Enum.HumanoidStateType.Freefall)
				local flat = Vector3.new(v.X, 0, v.Z)
				if flat.Magnitude > 3 then root.CFrame = CFrame.lookAt(root.Position, root.Position + flat) end
			end
			return
		end
		if S.climb then
			S.wallParams.FilterDescendantsInstances = { player.Character }
			local hit = Workspace:Raycast(root.Position, root.CFrame.LookVector * 3.2, S.wallParams)
			if hit and math.abs(hit.Normal.Y) < 0.5 and (S.clinging or hum.MoveDirection:Dot(-hit.Normal) > 0.2) then
				if hum.Jump then
					-- jump off the wall
					S.clinging = false
					root.AssemblyLinearVelocity = hit.Normal * 45 + Vector3.new(0, 45, 0)
					hum.Jump = false
					return
				end
				S.clinging = true
				hum:ChangeState(Enum.HumanoidStateType.Climbing)
				local up = hum.MoveDirection.Magnitude > 0.1 and 22 or 0
				root.AssemblyLinearVelocity = Vector3.new(0, up, 0) - hit.Normal * 4
				root.CFrame = CFrame.lookAt(root.Position, root.Position - hit.Normal)
			else
				S.clinging = false
			end
		end
	end)
end

