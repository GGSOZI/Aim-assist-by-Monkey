local function setOrbit(on)
	orbiting = on
	if onOrbitChanged then onOrbitChanged() end
end

-- runs after the aim code, so the orbit has the last word on the camera
RunService:BindToRenderStep("AimAssistOrbit", Enum.RenderPriority.Camera.Value + 2, function(dt)
	local cam = Workspace.CurrentCamera
	if not cam then return end
	local model = orbiting and pickedModel() or nil
	local root = model and (model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head"))
	if not root then
		if orbitCamSet then
			cam.CameraType = Enum.CameraType.Custom
			orbitCamSet = false
		end
		return
	end
	if not orbitCamSet then
		-- start from where the camera already is, so it does not jump
		local off = cam.CFrame.Position - root.Position
		orbitAngle = math.atan2(off.Z, off.X)
		cam.CameraType = Enum.CameraType.Scriptable
		orbitCamSet = true
	end
	orbitAngle += math.rad(CONFIG.OrbitSpeed) * dt
	local center = root.Position
	local pos = center + Vector3.new(
		math.cos(orbitAngle) * CONFIG.OrbitRadius,
		CONFIG.OrbitHeight,
		math.sin(orbitAngle) * CONFIG.OrbitRadius)
	cam.CFrame = CFrame.lookAt(pos, center + Vector3.new(0, 1.5, 0))
end)

