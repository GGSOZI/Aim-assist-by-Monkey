-- Joystick / WASD = move where the camera looks, Space / Up button = up, Ctrl / Down button = down.
local flying = false
local flyUp, flyDown = false, false
local flyBV, flyBG = nil, nil
local onFlyChanged = nil

local function cleanupFly()
	if flyBV then
		if flyBV.Attachment0 then flyBV.Attachment0:Destroy() end
		flyBV:Destroy()
		flyBV = nil
	end
	if flyBG then flyBG:Destroy() flyBG = nil end
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.PlatformStand = false
		hum.AutoRotate = true
	end
end

local function setFly(on)
	if on == flying then return end
	if on then
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not (root and hum) then return end
		local att = Instance.new("Attachment")
		att.Name = "MonkeyFlyAtt"
		att.Parent = root
		flyBV = Instance.new("LinearVelocity")
		flyBV.Attachment0 = att
		flyBV.RelativeTo = Enum.ActuatorRelativeTo.World
		flyBV.MaxForce = math.huge
		flyBV.VectorVelocity = Vector3.zero
		flyBV.Parent = root
		flyBG = Instance.new("AlignOrientation")
		flyBG.Mode = Enum.OrientationAlignmentMode.OneAttachment
		flyBG.Attachment0 = att
		flyBG.MaxTorque = math.huge
		flyBG.Responsiveness = 60
		flyBG.CFrame = root.CFrame
		flyBG.Parent = root
		hum.PlatformStand = true
		hum.AutoRotate = false
		flying = true
	else
		flying = false
		cleanupFly()
	end
	flyUp, flyDown = false, false
	if onFlyChanged then onFlyChanged() end
end

RunService.RenderStepped:Connect(function()
	if not flying then return end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local cam = Workspace.CurrentCamera
	if not root or not hum or hum.Health <= 0 or not cam or not flyBV or not flyBV.Parent then
		flying = false
		cleanupFly()
		if onFlyChanged then onFlyChanged() end
		return
	end

	local look, right = cam.CFrame.LookVector, cam.CFrame.RightVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	local flatRight = Vector3.new(right.X, 0, right.Z)
	local move = hum.MoveDirection
	local vel = Vector3.zero
	if flatLook.Magnitude > 0.01 then vel += look * move:Dot(flatLook.Unit) end
	if flatRight.Magnitude > 0.01 then vel += flatRight.Unit * move:Dot(flatRight.Unit) end

	local up = (flyUp or UserInputService:IsKeyDown(Enum.KeyCode.Space)) and 1 or 0
	local down = (flyDown or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)) and 1 or 0
	vel += Vector3.new(0, up - down, 0)

	flyBV.VectorVelocity = vel * CONFIG.FlySpeed
	if flatLook.Magnitude > 0.01 then
		flyBG.CFrame = CFrame.lookAt(root.Position, root.Position + flatLook)
	end
end)

player.CharacterAdded:Connect(function()
	flying = false
	flyUp, flyDown = false, false
	if onFlyChanged then onFlyChanged() end
end)

