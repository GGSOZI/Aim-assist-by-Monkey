-- ===== TARGETING =====
local held, toggled = false, false

local function isAiming()
	if lockOn or CONFIG.AutoTarget then return true end
	if CONFIG.Mode == "Always" then return true end
	if CONFIG.Mode == "Toggle" then return toggled end
	return held
end

local visParams = RaycastParams.new()
visParams.FilterType = Enum.RaycastFilterType.Exclude
local function isVisible(part, model)
	if not CONFIG.WallCheck then return true end
	local params = visParams -- one reused object instead of a new one per check
	local myChar = player.Character
	params.FilterDescendantsInstances = myChar and { myChar } or {}
	local origin = camera.CFrame.Position
	local result = Workspace:Raycast(origin, part.Position - origin, params)
	if result == nil or result.Instance:IsDescendantOf(model) then return true end
	if CONFIG.WallMulti then
		-- the aim part is covered: still fine when the body or head behind it can be seen
		for _, n in ipairs({ "Head", "UpperTorso", "Torso", "HumanoidRootPart" }) do
			local p = model:FindFirstChild(n)
			if p and p ~= part then
				local r = Workspace:Raycast(origin, p.Position - origin, params)
				if r == nil or r.Instance:IsDescendantOf(model) then return true end
			end
		end
	end
	return false
end

-- never target yourself (your character, anything inside it, your camera subject, or a clone with your name)
local function isSelf(model)
	local char = player.Character
	if model == char or (char and model:IsDescendantOf(char)) then return true end
	if Players:GetPlayerFromCharacter(model) == player then return true end
	if model.Name == player.Name then return true end
	if camera and model:IsDescendantOf(camera) then return true end -- first-person arms / viewmodels
	local head = model:FindFirstChild("Head")
	if head and camera and (head.Position - camera.CFrame.Position).Magnitude < 1.5 then return true end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum and camera and camera.CameraSubject == hum then return true end
	return false
end

-- forced = true: the player was picked in the player list, so skip team/type/distance filters
local function getCandidate(model, forced)
	if not model or not isCharacter(model) or isSelf(model) then return nil end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid or isDead(model) then return nil end
	-- "Any" and "Head" both aim at the head; "Any" also detects every other body part
	local aimName = CONFIG.Target == "HumanoidRootPart" and "HumanoidRootPart" or "Head"
	local part = model:FindFirstChild(aimName) or model:FindFirstChild("HumanoidRootPart")
	if not part then return nil end

	if not forced then
		local owner = Players:GetPlayerFromCharacter(model)
		if owner then
			if not CONFIG.TargetPlayers then return nil end
			if CONFIG.TeamCheck and owner.Team ~= nil and owner.Team == player.Team then return nil end
			if FX.skip and FX.skip(owner) then return nil end
		elseif not CONFIG.TargetNPCs then
			return nil
		end

		local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if myRoot and (part.Position - myRoot.Position).Magnitude > CONFIG.MaxDistance then return nil end
	end
	return part
end

-- pixels from the crosshair to the closest body part of this model (nil if it is off-screen)
local function fovDistance(model, aim)
	local viewport = camera.ViewportSize
	local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
	local detect = CONFIG.Target == "Any" and model:GetChildren() or { aim }
	local best = nil
	for _, p in ipairs(detect) do
		if p:IsA("BasePart") then
			local sp, onScreen = camera:WorldToViewportPoint(p.Position)
			if onScreen then
				local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
				if not best or d < best then best = d end
			end
		end
	end
	return best
end

-- ignoreFov = true: pick the closest target to the crosshair anywhere on screen (used by the Lock button)
local function getClosestTarget(ignoreFov)
	local viewport = camera.ViewportSize
	local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
	local best, bestDist = nil, ignoreFov and math.huge or CONFIG.FOVSize

	for humanoid in pairs(humanoids) do
		local model = humanoid.Parent
		local aim = getCandidate(model)
		if aim then
			-- find the body part closest to the crosshair (any part counts in "Any" mode)
			local detect = CONFIG.Target == "Any" and model:GetChildren() or { aim }
			local seen, seenDist = nil, math.huge
			for _, p in ipairs(detect) do
				if p:IsA("BasePart") then
					local sp, onScreen = camera:WorldToViewportPoint(p.Position)
					if onScreen then
						local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
						if d < seenDist then seen, seenDist = p, d end
					end
				end
			end
			-- aim is redirected to the head even if only an arm/leg/torso is in the circle
			if seen and seenDist < bestDist and isVisible(seen, model) then
				best, bestDist = aim, seenDist
			end
		end
	end
	return best
end

local sticky = nil
local lockedModel = nil     -- the one target the camlock is glued to
local onLockReleased = nil  -- set below; updates circle + button when the lock ends by itself
local queueChain = false    -- true after a queue target died: next target is picked up without needing the FOV
local queueHasAlive = false

-- multi-target: the first ALIVE player in the queue becomes the current target
-- distance from you to a model (used to pick the nearest queue target)
local function distanceTo(model)
	local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
	if not root then return math.huge end
	local me = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local origin = me and me.Position or (camera and camera.CFrame.Position) or Vector3.zero
	return (root.Position - origin).Magnitude
end

local function updateQueue()
	queueHasAlive = false
	local pick = nil
	for i = #CONFIG.TargetNames, 1, -1 do -- forget npcs that were removed from the game
		local n = CONFIG.TargetNames[i]
		if string.sub(n, 1, 4) == "npc:" then
			local m = npcModels[n]
			if not m or not m.Parent then table.remove(CONFIG.TargetNames, i) end
		elseif not Players:FindFirstChild(n) then
			table.remove(CONFIG.TargetNames, i) -- player left the server
		end
	end
	local bestD = math.huge
	for _, name in ipairs(CONFIG.TargetNames) do
		local p = queueEntry(name)
		local ch = p and p ~= player and p.Character
		if ch and not isDead(ch) then
			queueHasAlive = true
			local d = CONFIG.QueueNearest and distanceTo(ch) or 0
			if not pick or d < bestD then pick, bestD = name, d end
			if not CONFIG.QueueNearest then break end
		end
	end
	CONFIG.TargetName = pick or CONFIG.TargetNames[1]
end

-- the first queue entry that can really be aimed at right now -> model, aim part
-- (a dead / missing / un-aimable entry is skipped, so ONE bad entry can never block the rest)
local holdName = nil -- player the lock is waiting for (he is dead / ragdolled)
local manualPick = nil -- set by the Next button / N: that target is used first, until it dies
local function queueModel()
	if manualPick then
		if manualPick.Parent and not isDead(manualPick) then
			local part = getCandidate(manualPick, true)
			local inQueue = false
			for _, name in ipairs(CONFIG.TargetNames) do
				local e = queueEntry(name)
				if e and e.Character == manualPick then inQueue = true break end
			end
			if part and inQueue then return manualPick, part end
		end
		manualPick = nil
	end
	local bestCh, bestPart, bestD = nil, nil, math.huge
	for _, name in ipairs(CONFIG.TargetNames) do
		local p = queueEntry(name)
		local ch = p and p ~= player and p.Character
		local part = ch and not isDead(ch) and getCandidate(ch, true)
		if part then
			local ok = CONFIG.QueueIgnoreFov or queueChain
			if not ok then
				local d = fovDistance(ch, part)
				ok = d and d <= CONFIG.FOVSize and isVisible(part, ch)
			end
			if ok then
				if not CONFIG.QueueNearest then return ch, part end
				local d = distanceTo(ch)
				if d < bestD then bestCh, bestPart, bestD = ch, part, d end
			end
		end
	end
	return bestCh, bestPart
end

-- red outline on the locked target (while locked, only this target is highlighted)
local lockHighlight = Instance.new("Highlight")
lockHighlight.FillColor = CONFIG.FOVLockedColor
lockHighlight.OutlineColor = CONFIG.FOVLockedColor
lockHighlight.FillTransparency = 0.65
lockHighlight.OutlineTransparency = 0
lockHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
lockHighlight.Parent = gui

-- skip: moves the current target to the back of the queue and goes to the next one
local onQueueChanged = nil
local function nextTarget()
	-- everyone you could switch to, nearest first: the picked names, or every valid target when nobody is picked
	local list = {}
	if #CONFIG.TargetNames > 0 then
		for _, name in ipairs(CONFIG.TargetNames) do
			local e = queueEntry(name)
			local ch = e and e ~= player and e.Character
			if ch and not isDead(ch) and getCandidate(ch, true) then list[#list + 1] = ch end
		end
	else
		for humanoid in pairs(humanoids) do
			local m = humanoid.Parent
			if m and getCandidate(m) and not isDead(m) then list[#list + 1] = m end
		end
	end
	if #list == 0 then return end
	table.sort(list, function(x, y) return distanceTo(x) < distanceTo(y) end)
	local cur = lockedModel or (sticky and sticky.Parent) or manualPick
	local idx = table.find(list, cur) or 0
	local nxt = list[idx % #list + 1]
	if nxt == cur then return end -- only one target around
	if cur and FX.pushHist then FX.pushHist(cur) end
	manualPick = nxt
	holdName = nil
	lockedModel = nxt
	local part = getCandidate(nxt, true)
	sticky = part
	queueChain = true
	lockHighlight.Adornee = nil
	if onQueueChanged then onQueueChanged() end
end

-- which part the lock aims at
local LOCKPARTS = { "Same", "Head", "Body" }
local function lockPartFor(model, fallback)
	if CONFIG.LockPart == "Head" then
		return model:FindFirstChild("Head") or fallback
	elseif CONFIG.LockPart == "Body" then
		return model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
			or model:FindFirstChild("HumanoidRootPart") or fallback
	end
	return fallback
end

-- auto target: best candidate inside the fov circle by priority
local PRIORITIES = { "crosshair", "distance", "health" }
local function pickByPriority()
	local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local best, bestScore = nil, math.huge
	for humanoid in pairs(humanoids) do
		local model = humanoid.Parent
		local aim = getCandidate(model)
		if aim then
			local d = fovDistance(model, aim)
			if d and d <= CONFIG.FOVSize and isVisible(aim, model) then
				local score = d
				if CONFIG.AutoPriority == "distance" and myRoot then
					score = (aim.Position - myRoot.Position).Magnitude
				elseif CONFIG.AutoPriority == "health" then
					score = humanoid.Health
				end
				if score < bestScore then best, bestScore = aim, score end
			end
		end
	end
	return best
end

-- how far ahead (seconds) to lead a moving target
local function predictTime()
	if CONFIG.AutoPrediction then
		return math.clamp(player:GetNetworkPing() + 0.03, 0, 0.6)
	end
	return CONFIG.Prediction / 100
end

-- nearest valid target to you (no fov needed), used to jump to the next fight partner right after a kill
local function nearestTarget(skip)
	local best, bestD = nil, math.huge
	for humanoid in pairs(humanoids) do
		local model = humanoid.Parent
		if model ~= skip then
			local part = getCandidate(model)
			if part and not isDead(model) then
				local d = distanceTo(model)
				if d < bestD then best, bestD = part, d end
			end
		end
	end
	return best
end

local aimState = { pos = nil, model = nil, t = 0 }

-- ===== HUMANIZE: AIM ONLY WHEN SHOOTING =====
-- FX.isShooting() is true while mouse 1 is held, or while the equipped Tool is being activated (touch fire buttons too)
do
	local toolHeld, graceUntil = false, 0
	local hooked = setmetatable({}, { __mode = "k" })
	local function hookTool(tool)
		if hooked[tool] or not tool:IsA("Tool") then return end
		hooked[tool] = true
		tool.Activated:Connect(function() toolHeld = true end)
		tool.Deactivated:Connect(function()
			toolHeld = false
			graceUntil = os.clock() + 0.15 -- short grace so a quick tap still gets its aim
		end)
		tool.Unequipped:Connect(function() toolHeld = false end)
	end
	local function hookChar(char)
		toolHeld = false
		for _, c in ipairs(char:GetChildren()) do hookTool(c) end
		char.ChildAdded:Connect(hookTool)
	end
	if player.Character then hookChar(player.Character) end
	player.CharacterAdded:Connect(hookChar)
	FX.isShooting = function()
		return toolHeld or os.clock() < graceUntil
			or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
	end
end
-- runs right AFTER the default camera script so the roblox camera can't fight the lock
RunService:BindToRenderStep("AimAssistLock", Enum.RenderPriority.Camera.Value + 1, function(dt)
	camera = Workspace.CurrentCamera
	if not camera then return end
	updateQueue()

	if not CONFIG.Enabled or FX.paused or not isAiming() then
		holdName = nil
		sticky = nil
		queueChain = false
		lockHighlight.Adornee = nil
		return
	end

	-- humanize switch: the camera stays free until you shoot, then it goes to the target
	if CONFIG.AimOnShoot and not (FX.isShooting and FX.isShooting()) then
		lockHighlight.Adornee = nil
		return
	end

	-- the current queue target just died: the next one is picked up automatically (FOV not needed)
	if CONFIG.TargetName and sticky and sticky.Parent then
		local h = sticky.Parent:FindFirstChildOfClass("Humanoid")
		if h and h.Health <= 0 then queueChain = true end
	end

	local target
	-- lock button, or auto target when no queue is picked
	local locking = lockOn or (CONFIG.AutoTarget and #CONFIG.TargetNames == 0)
	if not locking then holdName = nil end
	if locking then
		-- the lock is waiting for a player who was just killed: aim stays paused until he is alive and up again
		if holdName then
			local e = queueEntry(holdName)
			local ch = e and e ~= player and e.Character
			if ch and ch.Parent and not isDead(ch) and getCandidate(ch, true) then
				lockedModel, holdName = ch, nil -- he is back: resume
			elseif e then
				sticky = nil
				lockHighlight.Adornee = nil
				return
			else
				holdName = nil -- he left the server
			end
		end
		-- CAMLOCK: pick one target, then stay glued to it (walls, FOV and distance no longer matter)
		if not lockedModel then
			if #CONFIG.TargetNames > 0 then
				lockedModel = (queueModel())
			else
				local acquired = (CONFIG.AutoTarget and pickByPriority()) or getClosestTarget(false) -- inside the fov circle
				lockedModel = acquired and acquired.Parent
			end
		end
		if lockedModel then
			if not lockedModel.Parent or isDead(lockedModel) then
				-- target died or left: with a queue move on automatically
				if queueHasAlive then
					lockedModel, sticky = nil, nil
					queueChain = true
					lockHighlight.Adornee = nil
					return
				end
				if not lockOn then
					-- auto target: just pick the next one
					lockedModel, sticky = nil, nil
					lockHighlight.Adornee = nil
					return
				end
				if CONFIG.HoldDeadTarget then
					if #CONFIG.TargetNames > 0 then
						-- picked names stay in the list; the queue picks them up again when they are back
						lockedModel, sticky = nil, nil
						lockHighlight.Adornee = nil
						return
					end
					local pl = Players:GetPlayerFromCharacter(lockedModel)
					if pl and pl ~= player then
						holdName = pl.Name
						lockedModel, sticky = nil, nil
						lockHighlight.Adornee = nil
						return
					end
				end
				-- no queue left: jump to the nearest other target, or release when there is nobody / the option is off
				if CONFIG.AutoNext then
					local nxt = nearestTarget(lockedModel)
					if nxt then
						lockedModel, sticky = nxt.Parent, nil
						lockHighlight.Adornee = nil
						return
					end
				end
				lockOn, lockedModel, sticky = false, nil, nil
				lockHighlight.Adornee = nil
				if onLockReleased then onLockReleased() end
				return
			end
			target = getCandidate(lockedModel, true)
			if not target then
				lockedModel, sticky = nil, nil -- cannot be aimed at (no head...): pick again next frame
				lockHighlight.Adornee = nil
				return
			end
			target = lockPartFor(lockedModel, target)
			if target and not CONFIG.LockThroughWalls and not isVisible(target, lockedModel) then
				target = nil -- behind a wall: aim pauses, the lock is kept
			end
		end
	elseif #CONFIG.TargetNames > 0 then
		-- players / npcs picked in the list: only aim at them, in queue order
		local _, part = queueModel()
		target = part
	else
		if (CONFIG.StickyAim or lockOn) and sticky and sticky.Parent then
			local part = getCandidate(sticky.Parent)
			if part and isVisible(part, sticky.Parent) then target = part end
		end
		if not target then
			target = getClosestTarget(lockOn)
		end
	end
	sticky = target
	lockHighlight.Adornee = locking and lockedModel or nil
	if not target then return end
	-- last line of defence: whatever path picked it, the camera never moves toward a dead or downed character
	do
		local owner = target:FindFirstAncestorOfClass("Model")
		if owner and isDead(owner) then
			sticky = nil
			lockHighlight.Adornee = nil
			return
		end
	end

	local aimPos = target.Position + Vector3.new(0, CONFIG.AimOffset / 10, 0) + target.AssemblyLinearVelocity * predictTime()
	if CONFIG.Humanize > 0 then
		local t = os.clock() * 1.7
		local wob = Vector3.new(math.noise(t, 0.3), math.noise(0.7, t), math.noise(t, t)) * (CONFIG.Humanize / 10)
		aimPos += wob
	end
	-- low-pass filter on the aim POINT: animation wobble and network jitter of the target no longer shake the camera
	local nowT = os.clock()
	if CONFIG.AimFilter > 0 then
		if not aimState.pos or aimState.model ~= target.Parent or nowT - aimState.t > 0.25 then
			aimState.pos = aimPos
		else
			local rate = 45 - CONFIG.AimFilter * 0.4
			aimState.pos = aimState.pos:Lerp(aimPos, 1 - math.exp(-dt * rate))
		end
		aimState.model, aimState.t = target.Parent, nowT
		aimPos = aimState.pos
	end
	local goal = CFrame.lookAt(camera.CFrame.Position, aimPos)
	local strength = lockOn and CONFIG.LockStrength or CONFIG.Smoothness
	-- frame-rate independent: same feel at 30 and 240 fps. strength 100 = hard snap
	local alpha = strength >= 100 and 1 or (1 - math.exp(-dt * (3 + strength * 0.5)))
	camera.CFrame = camera.CFrame:Lerp(goal, math.clamp(alpha, 0.02, 1))
end)

-- ===== SILENT AIM (for your own weapon scripts) =====
-- The camera does not move. Every frame the best target inside the FOV circle is published as:
--   player.SilentAimTarget.Value   (the Head / aim part, or nil)
--   _G.SilentAimTarget             (same part)
--   _G.SilentAimPosition()         (aim position incl. prediction, or nil)
-- In your OWN gun/tool LocalScript, aim the shot at that position instead of mouse.Hit.
local silentValue = Instance.new("ObjectValue")
silentValue.Name = "SilentAimTarget"
silentValue.Parent = player

_G.SilentAimTarget = nil
local lastSilentCall = 0 -- the menu shows whether a gun script is reading silent aim
_G.SilentAimPosition = function()
	lastSilentCall = os.clock()
	local t = _G.SilentAimTarget
	if t and t.Parent then
		return t.Position + Vector3.new(0, CONFIG.AimOffset / 10, 0) + t.AssemblyLinearVelocity * predictTime()
	end
	return nil
end

RunService.Heartbeat:Connect(function()
	camera = Workspace.CurrentCamera
	local target = nil
	updateQueue()
	if CONFIG.SilentAim and camera and (lockOn or CONFIG.AutoTarget) and lockedModel then
		-- locked: silent aim always follows the locked target
		target = getCandidate(lockedModel, true)
		if target then target = lockPartFor(lockedModel, target) end
	elseif CONFIG.SilentAim and camera then
		if #CONFIG.TargetNames > 0 then
			local _, part = queueModel()
			target = part
		else
			target = (CONFIG.AutoTarget and pickByPriority()) or getClosestTarget(false) -- inside the fov circle only
		end
	end
	if silentValue.Value ~= target then
		silentValue.Value = target
		_G.SilentAimTarget = target
	end
end)

-- ===== TRIGGERBOT =====
-- Holds your equipped Tool down (Tool:Activate / Tool:Deactivate) while the locked target
-- (or the player(s) picked in the list) is inside the trigger range AND under your crosshair.
-- It never fires at anybody else. Needs a Tool that reacts to Tool.Activated.
local triggerHeld = nil
local lastTrigger = 0

local function releaseTrigger()
	if triggerHeld then
		pcall(function() triggerHeld:Deactivate() end)
		triggerHeld = nil
	end
end

RunService.Heartbeat:Connect(function()
	local char = player.Character
	local tool = char and char:FindFirstChildOfClass("Tool")
	if not CONFIG.TriggerBot or not camera or not tool then
		releaseTrigger()
		return
	end
	if triggerHeld and triggerHeld ~= tool then releaseTrigger() end

	local trigModel = nil
	if (lockOn or CONFIG.AutoTarget) and lockedModel then
		trigModel = lockedModel
	elseif #CONFIG.TargetNames > 0 then
		trigModel = (queueModel())
	end
	local thum = trigModel and trigModel:FindFirstChildOfClass("Humanoid")
	local troot = trigModel and trigModel:FindFirstChild("HumanoidRootPart")
	local myRoot = char:FindFirstChild("HumanoidRootPart")
	if not (thum and not isDead(trigModel) and troot and myRoot)
		or (troot.Position - myRoot.Position).Magnitude > CONFIG.TriggerRange then
		releaseTrigger()
		return
	end

	-- is the crosshair on the target?
	local onTarget = false
	if CONFIG.SilentAim and silentValue.Value and silentValue.Value:IsDescendantOf(trigModel) then
		onTarget = true
	else
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { char }
		local vp = camera.ViewportSize
		local ray = camera:ViewportPointToRay(vp.X / 2, vp.Y / 2)
		local res = Workspace:Raycast(ray.Origin, ray.Direction * CONFIG.MaxDistance, params)
		if res and res.Instance:IsDescendantOf(trigModel) then
			onTarget = true
		else
			-- close enough on screen (small tolerance), and not blocked by a wall
			local d = fovDistance(trigModel, troot)
			onTarget = d ~= nil and d <= CONFIG.TriggerCrosshairPx and isVisible(troot, trigModel)
		end
	end

	if onTarget then
		if not triggerHeld then
			triggerHeld = tool
			lastTrigger = os.clock()
			tool:Activate()
		elseif os.clock() - lastTrigger >= CONFIG.TriggerDelayMs / 1000 then
			-- click again, for tools that fire once per click
			lastTrigger = os.clock()
			tool:Deactivate()
			tool:Activate()
		end
	else
		releaseTrigger()
	end
end)

-- ===== ESP =====
local espObjects = {}

local function removeESP(model)
	local obj = espObjects[model]
	if obj then
		obj.highlight:Destroy()
		obj.billboard:Destroy()
		obj.tracer:Destroy()
		if obj.box then obj.box:Destroy() end
		espObjects[model] = nil
	end
end

local function createESP(model)
	local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
	if not root then return end
	local color = CONFIG.ESPColor

	local highlight = Instance.new("Highlight")
	highlight.Adornee = model
	highlight.FillColor = color
	highlight.OutlineColor = color
	highlight.FillTransparency = 0.7
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = gui

	local billboard = Instance.new("BillboardGui")
	billboard.Adornee = root
	billboard.Size = UDim2.fromOffset(160, 36)
	billboard.StudsOffset = Vector3.new(0, 3.5, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = gui

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 20)
	label.BackgroundTransparency = 1
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.5
	label.Font = Enum.Font.Code
	label.TextSize = 13
	label.Parent = billboard

	local barBack = Instance.new("Frame")
	barBack.Position = UDim2.new(0.2, 0, 0, 24)
	barBack.Size = UDim2.new(0.6, 0, 0, 5)
	barBack.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	barBack.BorderSizePixel = 0
	barBack.Parent = billboard
	local barFill = Instance.new("Frame")
	barFill.Size = UDim2.fromScale(1, 1)
	barFill.BackgroundColor3 = Color3.fromRGB(110, 205, 120)
	barFill.BorderSizePixel = 0
	barFill.Parent = barBack

	-- fixed-size box around the torso: the old bounding-box version jumped around with every animation and accessory
	local box = Instance.new("BoxHandleAdornment")
	box.Adornee = root
	box.Size = Vector3.new(4, 5.5, 2)
	box.Color3 = CONFIG.ESPColor
	box.Transparency = 0.75
	box.AlwaysOnTop = true
	box.ZIndex = 1
	box.Visible = false
	box.Parent = gui

	local tracer = Instance.new("Frame")
	tracer.AnchorPoint = Vector2.new(0.5, 0.5)
	tracer.BackgroundColor3 = CONFIG.TracerColor
	tracer.BorderSizePixel = 0
	tracer.Visible = false
	tracer.ZIndex = 2
	tracer.Parent = gui

	espObjects[model] = { highlight = highlight, billboard = billboard, label = label,
		barBack = barBack, barFill = barFill, tracer = tracer, box = box }
end

task.spawn(function()
	while true do
		task.wait(0.2)
		local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		-- while locked or when a player is picked in the list, ESP only shows that one target
		updateQueue()
		-- ESP only narrows down once the lock really HAS a target (so it never just disappears)
		local lockedNow = lockOn and lockedModel ~= nil
		local filter = lockedNow or (not lockOn and #CONFIG.TargetNames > 0)
		local allowedSet = {}
		if lockOn then
			if lockedModel then allowedSet[lockedModel] = true end
		else
			for _, name in ipairs(CONFIG.TargetNames) do
				local picked = queueEntry(name)
				if picked and picked.Character then allowedSet[picked.Character] = true end
			end
		end

		for model in pairs(espObjects) do
			local hum = model.Parent and model:FindFirstChildOfClass("Humanoid")
			if not (CONFIG.ESPEnabled or CONFIG.TargetName or lockedNow) or not hum or hum.Health <= 0 or (filter and not allowedSet[model]) then
				removeESP(model)
			end
		end

		if CONFIG.ESPEnabled or CONFIG.TargetName or lockedNow then
			for humanoid in pairs(humanoids) do
				local model = humanoid.Parent
				if model and model:IsA("Model") and model ~= player.Character
					and humanoid.Health > 0 and not espObjects[model]
					and (not filter or allowedSet[model])
					and (allowedSet[model] or not CONFIG.ESPPlayersOnly or Players:GetPlayerFromCharacter(model) ~= nil) then
					local owner = Players:GetPlayerFromCharacter(model)
					local allowed = (owner and CONFIG.TargetPlayers) or (not owner and CONFIG.TargetNPCs)
					if allowed and owner and CONFIG.TeamCheck and owner.Team ~= nil and owner.Team == player.Team then
						allowed = false
					end
					if allowed then createESP(model) end
				end
			end

			for model, obj in pairs(espObjects) do
				local hum = model:FindFirstChildOfClass("Humanoid")
				local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
				if hum and root then
					local dist = myRoot and (root.Position - myRoot.Position).Magnitude or 0
					local show = dist <= CONFIG.ESPMaxDistance
					obj.highlight.Enabled = show
					obj.billboard.Enabled = show
					if show then
						local parts = {}
						if CONFIG.ESPNames then parts[#parts + 1] = model.Name end
						if CONFIG.ESPHealthBars then parts[#parts + 1] = "HP " .. math.floor(hum.Health) end
						if CONFIG.ESPTool then
							local tool = model:FindFirstChildOfClass("Tool")
							if tool then parts[#parts + 1] = tool.Name end
						end
						if CONFIG.ESPDistance then
