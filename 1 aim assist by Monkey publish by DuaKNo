	-- ---------- share: export / import a settings code ----------
	local ENUMS = {
		Mode = MODES, Target = TARGETS, LockPart = { "Same", "Head", "Body" }, AutoPriority = { "crosshair", "distance", "health" },
		TracerOrigin = { "body", "bottom", "center" }, Aesthetic = FX.aesList,
		Theme = { "dark", "ocean", "violet", "light" }, CamFx = FX.camfxList, MacroMode = { "hold", "toggle" },
	}
	local function esc(v) return (string.gsub(v, "[;=%% ]", function(c) return string.format("%%%02X", string.byte(c)) end)) end
	function FX.export()
		local out = { "MH2" }
		for _, key in ipairs(SAVE_KEYS) do
			local v = CONFIG[key]
			local t = type(v)
			if t == "boolean" then out[#out + 1] = key .. "=b" .. (v and 1 or 0)
			elseif t == "number" then out[#out + 1] = key .. "=n" .. v
			elseif t == "string" then out[#out + 1] = key .. "=s" .. esc(v) end
		end
		return table.concat(out, ";")
	end
	function FX.import(text)
		if type(text) ~= "string" then return false, "empty" end
		text = string.gsub(text, "%s+", "")
		local parts = string.split(text, ";")
		if parts[1] ~= "MH2" then return false, "that is not a monkey hub code" end
		local known = {}
		for _, k in ipairs(SAVE_KEYS) do known[k] = true end
		local n = 0
		for i = 2, #parts do
			local key, kind, val = string.match(parts[i], "^([%w_]+)=([bns])(.*)$")
			local cur = key and known[key] and CONFIG[key]
			if cur ~= nil then
				if kind == "b" and type(cur) == "boolean" then
					CONFIG[key] = val == "1"
					n += 1
				elseif kind == "n" and type(cur) == "number" then
					local x = tonumber(val)
					if x and x == x then CONFIG[key] = math.clamp(x, -10000, 10000) n += 1 end
				elseif kind == "s" and type(cur) == "string" then
					local sv = string.gsub(val, "%%(%x%x)", function(h) return string.char(tonumber(h, 16)) end)
					local okv = true
					if ENUMS[key] and not table.find(ENUMS[key], sv) then okv = false end
					if string.sub(key, 1, 4) == "Bind" and not pcall(function() return Enum.KeyCode[sv] end) then okv = false end
					if #sv > 600 or string.find(sv, "%c") then okv = false end
					if okv then CONFIG[key] = sv n += 1 end
				end
			end
		end
		CONFIG.FOVColor = Color3.fromRGB(CONFIG.FOVR, CONFIG.FOVG, CONFIG.FOVB)
		CONFIG.ESPColor = Color3.fromRGB(CONFIG.ESPR, CONFIG.ESPG, CONFIG.ESPB)
		CONFIG.TracerColor = Color3.fromRGB(CONFIG.TracerR, CONFIG.TracerG, CONFIG.TracerB)
		FX.wlSync()
		if FX.afterImport then FX.afterImport() end
		return true, n .. " settings loaded"
	end
end

